  [inst_3 : Fintype E] [inst_4 : Fintype X] [inst_5 : DecidableEq Copy] [inst_6 : Fintype Copy] [inst_7 : Nonempty Copy]
  (L : ℕ) (N : Nanuq.Source.RootedBinary V E X) {sample : Copy → X} (q : Fin L → Copy → ResearchCommons.MSCI.JC69.Base)
  (leafAge : Copy → ℝ) (z : UnifiedLean.Source.UniformizedSourceStep.Code N sample × (Copy → Copy → ℝ)),
  ResearchCommons.MSCI.JC69Source.GoodPoint N leafAge z →
