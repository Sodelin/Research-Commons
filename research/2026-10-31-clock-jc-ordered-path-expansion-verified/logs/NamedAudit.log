  (N : Nanuq.Source.RootedBinary V E X) {sample : Copy → X}
  (r : UnifiedLean.Source.NativePairClockLaw.PositivePairRates E) (L : ℕ)
  (q : Fin L → Copy → ResearchCommons.MSCI.JC69.Base) (n : ℕ)
  (s : UnifiedLean.Source.UniformizedSourceStep.Code N sample) (t : NNReal)
  (target : ResearchCommons.MSCI.JC69EndpointWeight.BlockPopulationObservation Copy V E),
  (ResearchCommons.MSCI.JC69EndpointWeight.actualResolvedWeight N r L q n s (↑t) target).toReal =
    ∑ h,
      ResearchCommons.MSCI.JC69OrderedPathExpansion.pathMass N r L q n s h ↑t *
        if
            ResearchCommons.MSCI.JC69EndpointWeight.observeCode N
                (ResearchCommons.MSCI.JC69OrderedPathExpansion.pathEnd N n s h) =
              target then
