@ResearchCommons.MSCI.JC69OrderedPathExpansion.actual_resolved_ordered_path_sum : ∀ {V : Type u_1} {E : Type u_2}
  {Copy : Type u_3} {X : Type u_4} [inst : DecidableEq V] [inst_1 : DecidableEq E] [inst_2 : Fintype V]
