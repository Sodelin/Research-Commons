@ResearchCommons.MSCI.JC69UnorderedContinuation.actual_orientation_real_integrand_sum : ∀ {V : Type u_1} {E : Type u_2}
  {Copy : Type u_3} {X : Type u_4} [inst : DecidableEq V] [inst_1 : DecidableEq E] [inst_2 : Fintype V]
  [inst_3 : Fintype E] [inst_4 : Fintype X] [inst_5 : DecidableEq Copy] [inst_6 : Fintype Copy]
  (N : Nanuq.Source.RootedBinary V E X) {sample : Copy → X}
  (r : UnifiedLean.Source.NativePairClockLaw.PositivePairRates E) (L : ℕ)
  (q : Fin L → Copy → ResearchCommons.MSCI.JC69.Base) (n : ℕ)
  (s : UnifiedLean.Source.UniformizedSourceStep.Code N sample) (p : UnifiedLean.Source.UniformizedSourceStep.Choice N s)
  (T : NNReal) (target : ResearchCommons.MSCI.JC69EndpointWeight.BlockPopulationObservation Copy V E),
  ∀ u ∈ Set.Icc 0 ↑T,
    UnifiedLean.Source.UniformizedSourceStep.choiceRate N r s p *
            Real.exp (-ResearchCommons.MSCI.JC69OrderedPathExpansion.holdingRate N r L q s * u) *
          (ResearchCommons.MSCI.JC69EndpointWeight.actualResolvedWeight N r L q n
              (UnifiedLean.Source.UniformizedSourceStep.stepDestination N s (some p)) (↑T - u) target).toReal +
        UnifiedLean.Source.UniformizedSourceStep.choiceRate N r s
              (ResearchCommons.MSCI.JC69UnorderedContinuation.reverseChoice N s p) *
            Real.exp (-ResearchCommons.MSCI.JC69OrderedPathExpansion.holdingRate N r L q s * u) *
          (ResearchCommons.MSCI.JC69EndpointWeight.actualResolvedWeight N r L q n
              (UnifiedLean.Source.UniformizedSourceStep.stepDestination N s
                (some (ResearchCommons.MSCI.JC69UnorderedContinuation.reverseChoice N s p)))
              (↑T - u) target).toReal =
      UnifiedLean.Source.NativePairClockLaw.pairRate r p.fst *
          Real.exp (-ResearchCommons.MSCI.JC69OrderedPathExpansion.holdingRate N r L q s * u) *
        (ResearchCommons.MSCI.JC69EndpointWeight.actualResolvedWeight N r L q n
            (UnifiedLean.Source.UniformizedSourceStep.stepDestination N s (some p)) (↑T - u) target).toReal
