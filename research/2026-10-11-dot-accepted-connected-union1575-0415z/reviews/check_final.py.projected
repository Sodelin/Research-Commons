 expected={**b,**records}
 report=final_check(g,expected);report.update(graph_sha256=GRAPH,compiler_invoked=False,distinct_file_hashes=len(MEMO),bytes_hashed=hashed_bytes,elapsed_seconds=time.time()-start)
 check(ROOT/'DEPENDENCY-GRAPH.json',GRAPH)
 (OUT/'FINAL-UNION-REVIEW.json').write_text(json.dumps(report,indent=2)+'\n')
 print(json.dumps({k:v for k,v in report.items() if k!='component_records'},indent=2))
