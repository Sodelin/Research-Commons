  'common':('15525987280d430dcb83585aaf76f5a33042ece6f1a781eeb2ed51949bd78934','6df3d6c8f923bd4d0ee05af2bab474bbed334bf2184879aa5b0354458d217021')}
 for label,(cp,ap) in remote_pins.items():
  folder=OUT/'remote-audits';cert=folder/(label+'.certificate.json');gz=folder/(label+'.json.gz');audit=folder/(label+'.audit.json');check(cert,cp);check(audit,ap)
  raw=gz.read_bytes();meta=read(folder/(label+'.fetch.json'));assert hashlib.sha1(b'blob '+str(len(raw)).encode()+b'\0'+raw).hexdigest()==meta['git_blob'];assert gzip.decompress(raw)==audit.read_bytes()
  assert next(iter(read(cert)['targets'].values()))['audit_raw_sha256']==ap
  for x in read(audit)['declarations']:
   n=x['name']
