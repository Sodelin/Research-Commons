   assert y['body_references'].count(oldhelper)==1 and newhelper not in y['body_references']
   assert x['body_references']==[newhelper if z==oldhelper else z for z in y['body_references']]
   deltas.append({'name':name,'changed_field':'body_references','reference':y,'actual':x})
