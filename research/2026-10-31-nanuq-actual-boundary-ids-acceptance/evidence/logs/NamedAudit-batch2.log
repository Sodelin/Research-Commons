    ∀ {e : E} {u v z : Schoenflies.Plane} {D : List.{u_1} E},
      Graph.IsCycleThrough.{0, u_1} G e u v D →
        Membership.mem.{0, 0} (Graph.vertexSet.{0, u_1} G) z →
          Membership.mem.{0, 0} (Graph.edgesCover.{u_1} drawing (List.cons.{u_1} e D)) z →
            ∃ f g,
              Ne.{u_1 + 1} f g ∧
                Membership.mem.{u_1, u_1} (List.cons.{u_1} e D) f ∧
                  Membership.mem.{u_1, u_1} (List.cons.{u_1} e D) g ∧
                    Graph.Inc.{0, u_1} G f z ∧ Graph.Inc.{0, u_1} G g z
