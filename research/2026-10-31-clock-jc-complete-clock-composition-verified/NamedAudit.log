ResearchCommons.MSCI.JC69CompleteClockComposition.actual_complete_clock_exposure.{u_1, u_2, u_3, u_4} {V : Type u_1}
  {E : Type u_2} {Copy : Type u_3} {X : Type u_4} [DecidableEq V] [DecidableEq E] [Fintype V] [Fintype E] [Fintype X]
  [DecidableEq Copy] [Fintype Copy] (N : Nanuq.Source.RootedBinary V E X) {sample : Copy → X}
  (r : UnifiedLean.Source.NativePairClockLaw.PositivePairRates E) (q : Copy → ResearchCommons.MSCI.JC69.Base)
  (leafAge : Copy → ℝ) (ops : List (UnifiedLean.Source.SourceProgramTransport.ProgramStep N))
  (s d : UnifiedLean.Source.UniformizedSourceStep.Code N sample) (offset : ℝ) (M : Copy → Copy → ℝ) :
  ∀ᵐ (past :
    Fin ops.length →
      GProgram.G2.ActualCalendarTrace.SegmentRecord N
        sample) ∂(GProgram.G2.ActualCalendarTrace.actualCalendarTraceLaw N r ops s).restrict
      {past | GProgram.G2.ActualCalendarTrace.calendarEnd N ops s past = d},
    ∀ (c : UnifiedLean.Source.UniformizedSourceStep.Choice N d → ℝ),
      ResearchCommons.MSCI.JC69Occupation.forestPotential q leafAge
          (UnifiedLean.Source.UniformizedSourceStep.state
            (GProgram.G2.CompleteDecoration.completeEnd N ops
              (ResearchCommons.MSCI.JC69CompleteClockComposition.completeClockRecord N ops d past c)))
          (GProgram.G2.CompleteDecoration.completeMatrix N ops s offset M
            (ResearchCommons.MSCI.JC69CompleteClockComposition.completeClockRecord N ops d past c))
          (offset + ↑(GProgram.G2.ChronologicalPathReadout.programDuration N ops) +
            ↑(GProgram.G2.FiniteAncestralTrace.clockCover N d c)) =
        ResearchCommons.MSCI.JC69Occupation.forestPotential q leafAge (UnifiedLean.Source.UniformizedSourceStep.state s)
            M offset +
          ResearchCommons.MSCI.JC69CompleteClockComposition.completeClockOccupation N q ops s d past c
