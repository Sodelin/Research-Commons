  [Fintype Copy] (L : ℕ) (q : Fin L → Copy → ResearchCommons.MSCI.JC69.Base) (leafAge : Copy → ℝ)
  (s : GProgram.SourceForest.State V E Copy) (hs : GProgram.SourceForest.Valid s) (hcard : s.live.card ≤ 1) (l : Copy)
  (hl : l ∈ s.live) (hbal : ∀ (j : Fin L), ∑ x, q j x = 0) (M : Copy → Copy → ℝ) (T : ℝ) :
  ResearchCommons.MSCI.JC69CompleteClockComposition.labelledTreeFourier L q leafAge (s.genealogy l) M =
    Real.exp (-(4 / 3 * ∑ j, ResearchCommons.MSCI.JC69Occupation.forestPotential (q j) leafAge s M T))
