ResearchCommons.MSCI.JC69CompleteClockComposition.calendar_time_duration.{u_1, u_2, u_4} {V : Type u_1} {E : Type u_2}
  {X : Type u_4} [DecidableEq V] [DecidableEq E] [Fintype V] [Fintype E] [Fintype X]
