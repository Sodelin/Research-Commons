n=pins['new_module'];f=D/(n+'.lean');assert sha(f)==pins['sha256'];mods[n]={'module':n,'sha256':sha(f),'imports':pins['direct_imports']};assert not any(n.startswith('Mathlib.') for n in mods);order=[n for n in base['order'] if n in mods]+[n];assert len(order)==242
