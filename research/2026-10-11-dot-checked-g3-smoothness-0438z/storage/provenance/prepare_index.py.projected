import json,hashlib
P=Path(__file__).resolve().parent;H=lambda p:hashlib.sha256(p.read_bytes()).hexdigest();entries=[]
for name,commit in [('connected-union1568-20261010-2318z','861b2320707c37e2d30f6c089ed7121d6fcbc51e'),('connected-union1570-g4span-20261011-0212z','b2a32273a644eef6296b6c194ecee6a3dfa72423')]:
 b=Path('$SHARED_WORKSPACE')/name;latest=json.loads((b/'.build/LATEST-RUN.json').read_bytes());run=Path(latest['run']);result=run/'targets/current_connected/RESULT.json';d=json.loads(result.read_bytes());a=d['audit_receipt'];raw=Path(a['audit_output']);transport=b/'publication-packet/AUDIT-TRANSPORT.json';t=json.loads(transport.read_bytes());assert H(raw)==t['raw_sha256'];entries.append({'raw_path':str(raw),'raw_sha256':H(raw),'raw_bytes':raw.stat().st_size,'result_path':str(result),'result_sha256':H(result),'final_receipt_path':str(run/'FINAL-RECEIPT.json'),'final_receipt_sha256':H(run/'FINAL-RECEIPT.json'),'transport_path':str(transport),'transport_sha256':H(transport),'gzip_sha256':t['gzip_sha256'],'public_commit':commit,'parts':[{'path':str(b/'publication-packet'/x['path']),'bytes':x['bytes'],'sha256':x['sha256']} for x in t['parts']]})
index={'schema':'two_completed_historical_audits_lossless_transport_v1','raw_files_changed':False,'entries':entries};p=P/'INDEX.json';p.write_text(json.dumps(index,indent=2)+'\n');print(H(p))
