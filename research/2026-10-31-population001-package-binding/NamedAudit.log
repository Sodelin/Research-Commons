ResearchCommons.Claims.CapTwoPopulation.exact_threshold : ∀ (cap : Nat) (s : Nat → Bool),
  (Exists.{1} fun E =>
      Exists.{1} fun S =>
        Exists.{1} fun g => FixedGenderLift.FixedGenderPopulation E S g cap ∧ ¬FixedGenderReindex.RealizesOn E S g s) ↔
    LE.le.{0} 2 cap ∧ ¬BinaryAvoidance.EventuallyPeriodic s
'ResearchCommons.Claims.CapTwoPopulation.exact_threshold' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
