ResearchCommons.Claims.CapTwoPopulation.actual_three_root_two_child_avoider : ∀ (s : Nat → Bool),
  ¬BinaryAvoidance.EventuallyPeriodic s →
    FixedGenderLift.FixedGenderPopulation CapTwo.Arc CapTwo.Vertices (CapTwo.gender s) 2 ∧
      (∀ (x : Nat),
          CapTwo.Vertices x →
            Exists.{1} fun a =>
              Exists.{1} fun b =>
                Ne.{1} a b ∧
                  CapTwo.Vertices a ∧ CapTwo.Vertices b ∧ ∀ (y : Nat), CapTwo.Arc x y ↔ Eq.{1} y a ∨ Eq.{1} y b) ∧
        (∀ (y : Nat),
            CapTwo.Vertices y ∧ SpeciesBridge.Root (FixedGenderLift.Induced CapTwo.Arc CapTwo.Vertices) y ↔
              Eq.{1} y 1 ∨ Eq.{1} y 2 ∨ Eq.{1} y 3) ∧
          ¬FixedGenderReindex.RealizesOn CapTwo.Arc CapTwo.Vertices (CapTwo.gender s) s
'ResearchCommons.Claims.CapTwoPopulation.actual_three_root_two_child_avoider' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
ResearchCommons.Claims.CapTwoPopulation.actual_parent_ids : ∀ (x y : Nat),
  LE.le.{0} 2 (CapTwo.source y) →
    (CapTwo.Arc x y ↔
