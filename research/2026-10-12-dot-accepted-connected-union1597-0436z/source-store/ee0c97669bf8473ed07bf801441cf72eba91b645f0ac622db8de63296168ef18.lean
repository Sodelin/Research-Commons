    · simp only [coeff_ofRows, s3_combined_row8, ofCoeffs_append_zeros, ofCoeffs_zeros, Polynomial.coeff_C]; norm_num
  · have hd : (ofRows s3CombinedOutput).natDegree < n := by
      have h := natDegree_ofRows_le s3CombinedOutput
      rw [s3_combined_length] at h
      omega
    rw [Polynomial.coeff_eq_zero_of_natDegree_lt hd]
    simp only [Polynomial.coeff_C]
    simp [show n ≠ 0 by omega]

theorem s3_D_coefficients : s3DCoeffs = scaleCoeffs s3K e3Coeffs := by decide

theorem s3_K_ne_zero : s3K ≠ 0 := by decide

theorem s3_D_binding : ofCoeffs s3DCoeffs = C s3K * ofCoeffs e3Coeffs := by
  rw [s3_D_coefficients, ofCoeffs_scale]

theorem s3_source_bezout : ∃ u v : Polynomial (Polynomial ℤ),
    u * ofRows s3PRows + v * ofRows s3QRows = C (C s3K * ofCoeffs e3Coeffs) := by
  refine ⟨ofRows (combineRows 16 (s3Blocks.map RowBezoutData.u)),
    ofRows (combineRows 16 (s3Blocks.map RowBezoutData.v)), ?_⟩
  have h := reconstruct_block_bezout 16 (ofRows s3PRows) (ofRows s3QRows) s3Blocks s3_block_identities
  change _ = ofRows s3CombinedOutput at h
  rw [s3_combined_polynomial, s3_D_binding] at h
  exact h

#print axioms s3_source_bezout
end GProgram.G3.CriticalCertificates
