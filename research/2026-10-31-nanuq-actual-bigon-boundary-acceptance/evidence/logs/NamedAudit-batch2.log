  (b : Nanuq.Source.EdgeGraph.Blob.{u_1, u_2} (Nanuq.Source.RootedBinary.graph.{u_1, u_2, u_3} N))
  (u v : Nanuq.RawBlock.BlobVertex.{u_1, u_2} (Nanuq.Source.RootedBinary.graph.{u_1, u_2, u_3} N) b),
  Ne.{u_1 + 1} u v →
    (∀ (w : Nanuq.RawBlock.BlobVertex.{u_1, u_2} (Nanuq.Source.RootedBinary.graph.{u_1, u_2, u_3} N) b),
        Eq.{u_1 + 1} w u ∨ Eq.{u_1 + 1} w v) →
      ∃ e f,
        Ne.{u_2 + 1} e f ∧
          (∀ (g : Nanuq.RawBlock.BlobEdge.{u_1, u_2} (Nanuq.Source.RootedBinary.graph.{u_1, u_2, u_3} N) b),
              Eq.{u_2 + 1} g e ∨ Eq.{u_2 + 1} g f) ∧
            ∃ s t,
              Graph.IsCycleThrough.{0, u_2}
                  (NanuqFaithfulSupplierDrawing.graph.{u_1, u_2} (Nanuq.RawBlockSupplier.blobCurves.{u_1, u_2} D b)) e s
                  t (List.cons.{u_2} f List.nil.{u_2}) ∧
                Schoenflies.IsJordanCurve
                    (Graph.edgesCover.{u_2}
                      (NanuqFaithfulSupplierDrawing.curve.{u_1, u_2} (Nanuq.RawBlockSupplier.blobCurves.{u_1, u_2} D b))
                      (List.cons.{u_2} e (List.cons.{u_2} f List.nil.{u_2}))) ∧
                  Eq.{1}
                    (Graph.pointSet.{u_2}
                      (NanuqFaithfulSupplierDrawing.graph.{u_1, u_2} (Nanuq.RawBlockSupplier.blobCurves.{u_1, u_2} D b))
                      (NanuqFaithfulSupplierDrawing.curve.{u_1, u_2}
                        (Nanuq.RawBlockSupplier.blobCurves.{u_1, u_2} D b)))
                    (Graph.edgesCover.{u_2}
                      (NanuqFaithfulSupplierDrawing.curve.{u_1, u_2} (Nanuq.RawBlockSupplier.blobCurves.{u_1, u_2} D b))
                      (List.cons.{u_2} e (List.cons.{u_2} f List.nil.{u_2})))
