theorem s5_D_binding : ofCoeffs s5DCoeffs = C s5K * ofCoeffs e5Coeffs := by
  rw [s5_D_coefficients, ofCoeffs_scale]

theorem s5_source_bezout : ∃ u v : Polynomial (Polynomial ℤ),
    u * ofRows s5PRows + v * ofRows s5QRows = C (C s5K * ofCoeffs e5Coeffs) := by
  refine ⟨ofRows (combineRows 16 (s5Blocks.map RowBezoutData.u)),
    ofRows (combineRows 16 (s5Blocks.map RowBezoutData.v)), ?_⟩
  have h := reconstruct_block_bezout 16 (ofRows s5PRows) (ofRows s5QRows) s5Blocks s5_block_identities
  change _ = ofRows s5CombinedOutput at h
  rw [s5_combined_polynomial, s5_D_binding] at h
  exact h

#print axioms s5_source_bezout
