theorem s5_combined_polynomial : ofRows s5CombinedOutput = C (ofCoeffs s5DCoeffs) := by
  apply Polynomial.ext
  intro n
  by_cases hn : n ≤ 8
  · interval_cases n
    · simp only [coeff_ofRows, s5_combined_row0, ofCoeffs_append_zeros, ofCoeffs_zeros, Polynomial.coeff_C]; norm_num
    · simp only [coeff_ofRows, s5_combined_row1, ofCoeffs_append_zeros, ofCoeffs_zeros, Polynomial.coeff_C]; norm_num
    · simp only [coeff_ofRows, s5_combined_row2, ofCoeffs_append_zeros, ofCoeffs_zeros, Polynomial.coeff_C]; norm_num
    · simp only [coeff_ofRows, s5_combined_row3, ofCoeffs_append_zeros, ofCoeffs_zeros, Polynomial.coeff_C]; norm_num
    · simp only [coeff_ofRows, s5_combined_row4, ofCoeffs_append_zeros, ofCoeffs_zeros, Polynomial.coeff_C]; norm_num
    · simp only [coeff_ofRows, s5_combined_row5, ofCoeffs_append_zeros, ofCoeffs_zeros, Polynomial.coeff_C]; norm_num
    · simp only [coeff_ofRows, s5_combined_row6, ofCoeffs_append_zeros, ofCoeffs_zeros, Polynomial.coeff_C]; norm_num
    · simp only [coeff_ofRows, s5_combined_row7, ofCoeffs_append_zeros, ofCoeffs_zeros, Polynomial.coeff_C]; norm_num
    · simp only [coeff_ofRows, s5_combined_row8, ofCoeffs_append_zeros, ofCoeffs_zeros, Polynomial.coeff_C]; norm_num
  · have hd : (ofRows s5CombinedOutput).natDegree < n := by
      have h := natDegree_ofRows_le s5CombinedOutput
      rw [s5_combined_length] at h
      omega
    rw [Polynomial.coeff_eq_zero_of_natDegree_lt hd]
    simp only [Polynomial.coeff_C]
    simp [show n ≠ 0 by omega]

theorem s5_D_coefficients : s5DCoeffs = scaleCoeffs s5K e5Coeffs := by decide

