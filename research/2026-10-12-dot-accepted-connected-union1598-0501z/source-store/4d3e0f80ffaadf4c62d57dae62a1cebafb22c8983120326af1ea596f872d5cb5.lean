theorem s5_block_identities : ∀ b ∈ s5Blocks,
    ofRows b.u * ofRows s5PRows + ofRows b.v * ofRows s5QRows = ofRows b.t := by
  simp only [s5Blocks, List.forall_mem_cons]
  exact ⟨s5_block0_identity, s5_block1_identity, s5_block2_identity, s5_block3_identity, s5_block4_identity, s5_block5_identity, s5_block6_identity, s5_block7_identity, s5_block8_identity, s5_block9_identity, s5_block10_identity, s5_block11_identity, s5_block12_identity, s5_block13_identity, s5_block14_identity, s5_block15_identity, s5_block16_identity, s5_block17_identity, s5_block18_identity, s5_block19_identity, s5_block20_identity, s5_block21_identity, s5_block22_identity, by simp⟩

theorem s5_combined_row0 : s5CombinedOutput.getD 0 [] = s5DCoeffs ++ List.replicate 29 0 := by decide

