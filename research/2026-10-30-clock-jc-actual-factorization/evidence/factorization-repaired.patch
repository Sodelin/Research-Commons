+variable {Copy : Type*} [Fintype Copy] [DecidableEq Copy] [Nonempty Copy]
+attribute [local instance] GProgram.G2.CompleteCalendarAttachment.unrankedForestMeasurable
+  GProgram.G2.LiteralMarkedClockTrace.codeMeasurable
+  GProgram.G2.CalendarHistoryBinding.joinedMeasurable
+  GProgram.G2.EventualPathReadout.terminalOptionMeasurable
