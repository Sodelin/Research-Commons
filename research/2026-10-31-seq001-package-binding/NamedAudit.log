ResearchCommons.Claims.SequenceFirstOccurrence.plus_first_occurrence : ∀ (n : ℕ),
  LE.le.{0} 2 n →
    Eq.{1} (ThueMorseMAP.A (HAdd.hAdd.{0, 0, 0} (HPow.hPow.{0, 0, 0} 2 n) 1))
        (HAdd.hAdd.{0, 0, 0} (HPow.hPow.{0, 0, 0} 2 n) 2) ∧
      Eq.{1} (ThueMorseMAP.i (HAdd.hAdd.{0, 0, 0} (HPow.hPow.{0, 0, 0} 2 n) 1))
        (HSub.hSub.{0, 0, 0}
          (HSub.hSub.{0, 0, 0} (HMul.hMul.{0, 0, 0} 3 (HPow.hPow.{0, 0, 0} 2 (HMul.hMul.{0, 0, 0} 2 n)))
            (HPow.hPow.{0, 0, 0} 2 n))
          1)
