@ResearchCommons.Claims.SequenceFirstOccurrence.plus_all_starts : ∀ {m s : ℕ},
  LE.le.{0} 2 m →
    (ThueMorseMAP.Mono s (HAdd.hAdd.{0, 0, 0} (HPow.hPow.{0, 0, 0} 2 m) 1)
        (HAdd.hAdd.{0, 0, 0} (HPow.hPow.{0, 0, 0} 2 m) 2) ↔
      ∃ l,
        ThueMorseMAP.Center l ∧
          Eq.{1} (HAdd.hAdd.{0, 0, 0} (HAdd.hAdd.{0, 0, 0} s (HPow.hPow.{0, 0, 0} 2 m)) 1)
            (HMul.hMul.{0, 0, 0} (HMul.hMul.{0, 0, 0} l (HPow.hPow.{0, 0, 0} 2 m)) (HPow.hPow.{0, 0, 0} 2 m)))
'ResearchCommons.Claims.SequenceFirstOccurrence.plus_all_starts' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
@ResearchCommons.Claims.SequenceFirstOccurrence.even_minus_all_starts : ∀ {m s : ℕ},
  LE.le.{0} 2 m →
    Eq.{1} (HMod.hMod.{0, 0, 0} m 2) 0 →
      (ThueMorseMAP.Mono s (HSub.hSub.{0, 0, 0} (HPow.hPow.{0, 0, 0} 2 m) 1)
          (HAdd.hAdd.{0, 0, 0} (HPow.hPow.{0, 0, 0} 2 m) 4) ↔
        ∃ l,
          ThueMorseMAP.Center l ∧
            Eq.{1} (HAdd.hAdd.{0, 0, 0} s (HPow.hPow.{0, 0, 0} 2 m))
              (HAdd.hAdd.{0, 0, 0}
                (HMul.hMul.{0, 0, 0} (HMul.hMul.{0, 0, 0} l (HPow.hPow.{0, 0, 0} 2 m)) (HPow.hPow.{0, 0, 0} 2 m)) 1))
'ResearchCommons.Claims.SequenceFirstOccurrence.even_minus_all_starts' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
ResearchCommons.Claims.SequenceFirstOccurrence.canonical_three_families : (∀ (n : ℕ),
    LE.le.{0} 2 n →
      Eq.{1} (ThueMorseMAP.A (HAdd.hAdd.{0, 0, 0} (HPow.hPow.{0, 0, 0} 2 n) 1))
          (HAdd.hAdd.{0, 0, 0} (HPow.hPow.{0, 0, 0} 2 n) 2) ∧
        Eq.{1} (ThueMorseMAP.i (HAdd.hAdd.{0, 0, 0} (HPow.hPow.{0, 0, 0} 2 n) 1))
          (HSub.hSub.{0, 0, 0}
            (HSub.hSub.{0, 0, 0} (HMul.hMul.{0, 0, 0} 3 (HPow.hPow.{0, 0, 0} 2 (HMul.hMul.{0, 0, 0} 2 n)))
              (HPow.hPow.{0, 0, 0} 2 n))
            1)) ∧
  (∀ (n : ℕ),
      LE.le.{0} 1 n →
        Eq.{1} (ThueMorseMAP.A (HSub.hSub.{0, 0, 0} (HPow.hPow.{0, 0, 0} 2 (HMul.hMul.{0, 0, 0} 2 n)) 1))
            (HAdd.hAdd.{0, 0, 0} (HPow.hPow.{0, 0, 0} 2 (HMul.hMul.{0, 0, 0} 2 n)) 4) ∧
          Eq.{1} (ThueMorseMAP.i (HSub.hSub.{0, 0, 0} (HPow.hPow.{0, 0, 0} 2 (HMul.hMul.{0, 0, 0} 2 n)) 1))
            (HAdd.hAdd.{0, 0, 0}
              (HSub.hSub.{0, 0, 0} (HMul.hMul.{0, 0, 0} 3 (HPow.hPow.{0, 0, 0} 2 (HMul.hMul.{0, 0, 0} 4 n)))
                (HPow.hPow.{0, 0, 0} 2 (HMul.hMul.{0, 0, 0} 2 n)))
              1)) ∧
    ∀ (n : ℕ),
      Eq.{1}
          (ThueMorseMAP.A
            (HSub.hSub.{0, 0, 0} (HPow.hPow.{0, 0, 0} 2 (HAdd.hAdd.{0, 0, 0} (HMul.hMul.{0, 0, 0} 2 n) 1)) 1))
          (HPow.hPow.{0, 0, 0} 2 (HAdd.hAdd.{0, 0, 0} (HMul.hMul.{0, 0, 0} 2 n) 1)) ∧
        Eq.{1}
          (ThueMorseMAP.i
            (HSub.hSub.{0, 0, 0} (HPow.hPow.{0, 0, 0} 2 (HAdd.hAdd.{0, 0, 0} (HMul.hMul.{0, 0, 0} 2 n) 1)) 1))
          (HSub.hSub.{0, 0, 0} (HPow.hPow.{0, 0, 0} 2 (HAdd.hAdd.{0, 0, 0} (HMul.hMul.{0, 0, 0} 2 n) 1)) 1)
