                    (∀ (x : Coord) (m s : Node),
                        Finset.Nonempty.{u_1} (WongGARG.GARG.samples.{u_1, u_2} G) →
                          WongMRCATruncation.IsMRCA.{u_1, u_2} G x m →
                            Membership.mem.{u_1, u_1} (WongGARG.GARG.samples.{u_1, u_2} G) s →
