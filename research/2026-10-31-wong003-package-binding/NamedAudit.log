                    x)
                  a b) ∧
            (∀ (x : Coord),
                WongGARG.GARG.UniqueParentAt.{u_1, u_2} G x →
                  WongGARG.GARG.UniqueParentAt.{u_1, u_2} H x ∧
                    WongSimplificationNormalForm.NoNonsampleUnary.{u_1, u_2} H x) ∧
              WongGARG.GARG.SampleSupported.{u_1, u_2} H ∧
                WongGARG.GARG.breakpoints.{u_1, u_2} H ⊆ WongGARG.GARG.breakpoints.{u_1, u_2} G ∧
                  (∀ (x : Coord) (a s : Node),
                      Membership.mem.{u_1, u_1} (WongGARG.GARG.samples.{u_1, u_2} G) a →
                        Membership.mem.{u_1, u_1} (WongGARG.GARG.samples.{u_1, u_2} G) s →
                          (AncestryViews.Reach.{u_1} (WongGARG.GARG.AtLocus.{u_1, u_2} H x) a s ↔
