                                  Membership.mem.{u_2, u_2} (WongGARG.EdgeRecord.regions.{u_1, u_2} e) J →
                                    Ne.{u_2 + 1} I J →
                                      LT.lt.{u_2} (WongGARG.Interval.hi.{u_2} I) (WongGARG.Interval.lo.{u_2} J) ∨
                                        LT.lt.{u_2} (WongGARG.Interval.hi.{u_2} J) (WongGARG.Interval.lo.{u_2} I)) ∧
                        Eq.{max (u_1 + 1) (u_2 + 1)} (WongIntervalCanonicalization.canonicalize.{u_1, u_2} H) H
