                                AncestryViews.Reach.{u_1} (WongGARG.GARG.AtLocus.{u_1, u_2} G x) m s)) ∧
                      (∀ (e : WongGARG.EdgeRecord.{u_1, u_2} Node Coord),
                          Membership.mem.{max u_1 u_2, max u_1 u_2} (WongGARG.GARG.records.{u_1, u_2} H) e →
                            ∀ (I : WongGARG.Interval.{u_2} Coord),
                              Membership.mem.{u_2, u_2} (WongGARG.EdgeRecord.regions.{u_1, u_2} e) I →
