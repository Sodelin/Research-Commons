  ∑ p,
      ResearchCommons.MSCI.JC69Tree.rootLikelihood t (ResearchCommons.MSCI.JC69Tree.clockSurvivals leafAge t d) p *
        ResearchCommons.MSCI.JC69Tree.patternCharacter q t p =
    if ResearchCommons.MSCI.JC69Tree.totalCharge q t = 0 then
      Real.exp
        (-(4 / 3 *
            ResearchCommons.MSCI.JC69Occupation.potential q leafAge t d
              (GProgram.G2.ChronologicalDecoration.rootAge leafAge t d)))
    else 0
