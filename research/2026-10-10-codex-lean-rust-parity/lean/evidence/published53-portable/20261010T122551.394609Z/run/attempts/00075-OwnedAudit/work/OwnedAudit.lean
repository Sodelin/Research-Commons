1ActualDisplayedClusterSplitTransport", "G1ActualDisplayedQuartetTransport", "G1ActualDisplayedTreeFamily", "G1ActualWholeUnrootedCutTreeFamily", "G1JointSeparatedSourceGeometry", "G1ComponentDescendantClosure", "G1ActualCutDescendants", "G1NaturalCalendarNodes", "G1ActualEnteringFrontier", "G1InitializedFrontierPrefix", "G1OriginalRegistryBigon", "G1ActualJointGenerator", "G1TensorExponential", "G1ActualJointEpoch", "G1ActualJointBoundary", "G1ActualJointProgram", "G1ActualComponentAgenda", "G1CanonicalComponentSegment", "G1ActualCurrentPanelInitialization", "G1JointUnrankedForestAssembly", "G1JointForestPreservation", "G1ActualJointOpaqueContext", "G1SameOriginalExteriorContinuation", "G1InitializedJointComponentReplacement", "G1OriginalCalendarDecomposition", "G1ActualJointStageHistory", "G1OriginalEpochRecomposition", "G1ExteriorBoundarySilence", "G1InterleavedEpochCompression", "G1OriginalEpochPanelSilence", "G1OriginalEpochPanelCompression", "G1OriginalNodeBatchBinding", "G1OriginalExitBatchBinding", "G1CanonicalThreeEpochList", "G1CompactSourceComposition", "G1OriginalComponentNodeIdentity", "G1CanonicalEpochBlockBinding", "G1CanonicalEpochSpecialization", "G1CompactComponentBlockRows", "G1CanonicalCompactComponentRow", "G1CanonicalSingleExitSupport", "G1UnrankedSourceView", "G1UnrankedActualGenerator", "G1UnrankedActualEpoch", "G1UnrankedNaturalPulse", "G1UnrankedActualBoundary", "G1UnrankedActualFuture", "G1ActualUnrankedAncestralCompletion", "G1ActualUnrankedCompletedFuture", "G1UnrankedSingleExitLabel", "G1ActualUnrankedKMacro", "G1ActualKProductInsertion", "G1ActualCompletedKInsertion", "G1OriginalCompletedForestReconstruction", "G1CanonicalCompletedFutureRootAdmission", "G1OriginalForestKOnlyInsertion", "G1UnrankedExteriorHistoryKInsertion", "G1CompletedExteriorHistoryKInsertion", "G1CanonicalOriginalCompletedKLaw", "G1CanonicalCompactCompletedReplacement", "G1ActualGraphNormalization", "GraphPortConsequences", "G1ReducedQuotientGeometry", "G1ReducedCoreCounts", "G1BinaryCoreBudgets", "G1OriginalDecoratedSpan", "G1DecoratedOriginalProvenance", "G1LiftedOriginalBigon", "G1DecoratedSpliceConstruction", "G1FiniteOriginalDecoratedCore", "G1FiniteNormalizationDisplayedTargets", "G1FiniteCoreWholeDisplayedTreeFamilies"]
  let imported := environment.header.moduleNames.map Name.toString
  let indices := environment.header.moduleNames.map (fun n => names.contains n.toString)
  let mut declarations : Array Json := #[]
  let mut invalid : Array Json := #[]
  let mut ownedAxioms : Array String := #[]
  let mut theorems : Nat := 0
  for (name, information) in environment.constants do
    if let some index := environment.getModuleIdxFor? name then
      if indices[index.toNat]! then
        let axioms ← collectAxioms name
        let kind := match information with
          | .thmInfo _ => "theorem"
          | .axiomInfo _ => "axiom"
          | .defnInfo _ => "definition"
          | .opaqueInfo _ => "opaque"
          | .inductInfo _ => "inductive"
          | .ctorInfo _ => "constructor"
          | .recInfo _ => "recursor"
          | .quotInfo _ => "quotient"
        if kind == "theorem" then theorems := theorems + 1
        if kind == "axiom" then ownedAxioms := ownedAxioms.push name.toString
        let refs := match information.value? (allowOpaque := true) with
          | some expression => expression.getUsedConstants.map Name.toString
          | none => #[]
        let record := Json.mkObj [
          ("module", toJson imported[index.toNat]!), ("name", toJson name.toString),
          ("kind", toJson kind), ("axioms", toJson (axioms.map Name.toString)),
          ("type_references", toJson (information.type.getUsedConstants.map Name.toString)),
          ("body_references", toJson refs)]
        declarations := declarations.push record
        if axioms.any (fun ax => ! #[``propext, ``Classical.choice, ``Quot.sound].contains ax) then
          invalid := invalid.push record
  let missing := names.filter (fun n => ! imported.contains n)
  let result := Json.mkObj [
    ("selected_modules", toJson names), ("all_imported_module_names", toJson imported),
    ("declaration_count", toJson declarations.size),
    ("theorem_declaration_count", toJson theorems), ("owned_axioms", toJson ownedAxioms),
    ("nonstandard_axiom_rows", toJson invalid), ("missing_modules", toJson missing),
    ("declarations", toJson declarations)]
  liftIO <| IO.FS.writeFile "AUDIT-RESULT.json" result.pretty
  logInfo m!"Fresh closure: {declarations.size} declarations, {theorems} theorems, {ownedAxioms.size} owned axioms, {invalid.size} nonstandard rows, {missing.size} missing modules"
  unless ownedAxioms.isEmpty && invalid.isEmpty && missing.isEmpty do
    throwError "Fresh complete closure audit failed"
