def MSCi.TwoSite.pairTransform : MSCi.TwoSite.Parameters → MSCi.TwoSite.Pair → ℝ → ℝ :=
fun p pair z =>
  have u := HSub.hSub.{0, 0, 0} p.t1 p.h;
  have v := HSub.hSub.{0, 0, 0} p.t0 p.t1;
  have E := fun t => Real.exp (HMul.hMul.{0, 0, 0} (Neg.neg.{0} z) t);
  have S := fun r l => Real.exp (HMul.hMul.{0, 0, 0} (Neg.neg.{0} r) l);
  have H := fun r l =>
    HMul.hMul.{0, 0, 0} (HDiv.hDiv.{0, 0, 0} r (HAdd.hAdd.{0, 0, 0} r z))
      (HSub.hSub.{0, 0, 0} 1 (Real.exp (HMul.hMul.{0, 0, 0} (Neg.neg.{0} (HAdd.hAdd.{0, 0, 0} r z)) l)));
  have root := HDiv.hDiv.{0, 0, 0} p.rR (HAdd.hAdd.{0, 0, 0} p.rR z);
  have s := S p.rB p.h;
  have b := S p.rB u;
  have a := S p.rAB v;
  have c1 := S p.rC (HAdd.hAdd.{0, 0, 0} u v);
  have a0 := S p.rA p.t1;
  have c0 := S p.rC p.t0;
  match pair with
  | MSCi.TwoSite.Pair.AC => HMul.hMul.{0, 0, 0} (E p.t0) root
  | MSCi.TwoSite.Pair.AB =>
    HAdd.hAdd.{0, 0, 0} (HMul.hMul.{0, 0, 0} (HMul.hMul.{0, 0, 0} (HSub.hSub.{0, 0, 0} 1 p.g) (E p.t1)) (H p.rAB v))
      (HMul.hMul.{0, 0, 0}
        (HMul.hMul.{0, 0, 0} (HAdd.hAdd.{0, 0, 0} p.g (HMul.hMul.{0, 0, 0} (HSub.hSub.{0, 0, 0} 1 p.g) a)) (E p.t0))
        root)
  | MSCi.TwoSite.Pair.BC =>
