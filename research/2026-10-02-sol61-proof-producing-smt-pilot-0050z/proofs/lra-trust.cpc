(declare-const y Real)
(declare-const x Real)
(define @t1 () (/ 1/1 3/1))
(define @t2 () (>= x @t1))
(define @t3 () (/ 2/1 3/1))
(define @t4 () (>= y @t3))
(define @t5 () (+ x y))
(define @t6 () (* -1/1 1/3))
(define @t7 () (* -1/1 2/3))
(define @t8 () (+ 1/1 @t7 @t6))
(define @t9 () (* -1/1 y))
(define @t10 () (* -1/1 x))
(define @t11 () (+ @t10 @t9 y x))
(define @t12 () (+ @t5 @t9 @t10))
(define @t13 () (>= @t12 @t8))
(assume @p1 @t2)
(assume @p2 @t4)
(assume @p3 (< @t5 1/1))
(step @p4 false :rule trust :args (false))
