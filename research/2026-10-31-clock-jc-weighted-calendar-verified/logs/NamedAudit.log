@ResearchCommons.MSCI.JC69WeightedCalendar.actual_calendar_weight_exponential : ∀ {V : Type u_1} {E : Type u_2}
  {Copy : Type u_3} {X : Type u_4} [inst : DecidableEq V] [inst_1 : DecidableEq E] [inst_2 : Fintype V]
  [inst_3 : Fintype E] [inst_4 : Fintype X] [inst_5 : DecidableEq Copy] [inst_6 : Fintype Copy]
  (N : Nanuq.Source.RootedBinary V E X) {sample : Copy → X}
  (r : UnifiedLean.Source.NativePairClockLaw.PositivePairRates E) (L : ℕ)
  (q : Fin L → Copy → ResearchCommons.MSCI.JC69.Base)
  (ops : List (UnifiedLean.Source.SourceProgramTransport.ProgramStep N))
  (s : UnifiedLean.Source.UniformizedSourceStep.Code N sample),
  ∀ᵐ (past :
    Fin ops.length →
      GProgram.G2.ActualCalendarTrace.SegmentRecord N
        sample) ∂GProgram.G2.ActualCalendarTrace.actualCalendarTraceLaw N r ops s,
    ResearchCommons.MSCI.JC69WeightedCalendar.calendarWeight N L q ops s past =
      ENNReal.ofReal
        (Real.exp (-(4 / 3 * ∑ j, ResearchCommons.MSCI.JC69CalendarOccupation.calendarOccupation N (q j) ops s past)))
'ResearchCommons.MSCI.JC69WeightedCalendar.actual_calendar_weight_exponential' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
