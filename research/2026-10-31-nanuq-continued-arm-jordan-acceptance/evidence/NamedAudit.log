@Nanuq.ContinuedArms.complementary_arc_of_continuations : ∀ {A J₁ J₂ : Set Schoenflies.Plane}
  {q₁ q₂ r₁ r₂ : Schoenflies.Plane},
  Schoenflies.IsArcBetween A q₁ q₂ →
    Schoenflies.IsArcBetween J₁ q₁ r₁ →
      Schoenflies.IsArcBetween J₂ q₂ r₂ →
        Disjoint J₁ J₂ →
          r₁ ∉ A →
            r₂ ∉ A →
              (∀ z ∈ J₁, z ∈ A → z = q₁) →
                (∀ z ∈ J₂, z ∈ A → z = q₂) →
                  ∃ B, Schoenflies.IsArcBetween B q₁ q₂ ∧ A ∩ B = {q₁, q₂} ∧ Schoenflies.IsJordanCurve (A ∪ B)
'Nanuq.ContinuedArms.complementary_arc_of_continuations' depends on axioms: [propext, Classical.choice, Quot.sound]
Nanuq.ContinuedArms.jordan_through_two_germs : ∀ (f g : ℝ → Schoenflies.Plane),
  ContinuousOn f unitInterval →
    ContinuousOn g unitInterval →
      Set.InjOn f unitInterval →
        Set.InjOn g unitInterval →
          f 0 = g 0 →
            (∀ z ∈ f '' unitInterval, z ∈ g '' unitInterval → z = f 0) →
              ∃ B,
                Schoenflies.IsArcBetween B (f (1 / 3)) (g (1 / 3)) ∧
                  (f '' Set.Icc 0 (1 / 3) ∪ g '' Set.Icc 0 (1 / 3)) ∩ B = {f (1 / 3), g (1 / 3)} ∧
                    Schoenflies.IsJordanCurve (f '' Set.Icc 0 (1 / 3) ∪ g '' Set.Icc 0 (1 / 3) ∪ B) ∧ f 0 ∉ B
'Nanuq.ContinuedArms.jordan_through_two_germs' depends on axioms: [propext, Classical.choice, Quot.sound]
@Nanuq.ContinuedArms.jordan_germs_of_isDrawing : ∀ {E : Type u_1} {G : Graph Schoenflies.Plane E}
  {drawing : E → ℝ → Schoenflies.Plane},
  G.IsDrawing drawing →
    ∀ {e₁ e₂ : E} {v w₁ w₂ : Schoenflies.Plane},
      G.IsLink e₁ v w₁ →
        G.IsLink e₂ v w₂ →
          e₁ ≠ e₂ →
            ∃ f g C,
              ContinuousOn f unitInterval ∧
                Set.InjOn f unitInterval ∧
                  f '' unitInterval = Graph.edgeArc drawing e₁ ∧
                    f 0 = v ∧
                      f 1 = w₁ ∧
                        ContinuousOn g unitInterval ∧
                          Set.InjOn g unitInterval ∧
                            g '' unitInterval = Graph.edgeArc drawing e₂ ∧
                              g 0 = v ∧
                                g 1 = w₂ ∧
                                  Schoenflies.IsJordanCurve C ∧ f '' Set.Icc 0 (1 / 6) ∪ g '' Set.Icc 0 (1 / 6) ⊆ C
'Nanuq.ContinuedArms.jordan_germs_of_isDrawing' depends on axioms: [propext, Classical.choice, Quot.sound]
@Nanuq.ContinuedArms.actual_original_incident_germs : ∀ {V : Type u_1} {E : Type u_2} {G : Nanuq.Source.EdgeGraph V E}
  (D : G1OuterLabelledMultigraphCurves.PlanarCurves G) {e₁ e₂ : E} {v w₁ w₂ : V},
  G.Inc e₁ v w₁ →
    G.Inc e₂ v w₂ →
      e₁ ≠ e₂ →
        ∃ f g C,
          ContinuousOn f unitInterval ∧
            Set.InjOn f unitInterval ∧
              f '' unitInterval = Graph.edgeArc (NanuqFaithfulSupplierDrawing.curve D) e₁ ∧
                f 0 = NanuqFaithfulSupplierDrawing.vertex D v ∧
                  f 1 = NanuqFaithfulSupplierDrawing.vertex D w₁ ∧
                    ContinuousOn g unitInterval ∧
                      Set.InjOn g unitInterval ∧
                        g '' unitInterval = Graph.edgeArc (NanuqFaithfulSupplierDrawing.curve D) e₂ ∧
                          g 0 = NanuqFaithfulSupplierDrawing.vertex D v ∧
                            g 1 = NanuqFaithfulSupplierDrawing.vertex D w₂ ∧
                              Schoenflies.IsJordanCurve C ∧ f '' Set.Icc 0 (1 / 6) ∪ g '' Set.Icc 0 (1 / 6) ⊆ C
'Nanuq.ContinuedArms.actual_original_incident_germs' depends on axioms: [propext, Classical.choice, Quot.sound]
