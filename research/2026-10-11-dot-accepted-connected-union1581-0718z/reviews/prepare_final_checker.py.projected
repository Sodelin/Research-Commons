a=s.index('def main():')
s=s[:a]+'''def main():
 global RUN,ACCEPTED_RECEIPTS
 import importlib.util
 start=time.time();RUN=Path(read(ROOT/'.build/LATEST-RUN.json')['run']);assert RUN.name=='20261011T071024.079941Z'
 for name,w in PINS.items():check(ROOT/name,w)
 check(ROOT/'DEPENDENCY-GRAPH.json',GRAPH);check(RUN/'DEPENDENCY-GRAPH.json',GRAPH)
 graph=read(ROOT/'DEPENDENCY-GRAPH.json');g=graph['targets']['current/connected']
 for n,x in g['modules'].items():
  p=ROOT/'source-store'/(x['sha256']+'.lean');check(p,x['sha256']);assert imports(p.read_bytes())==x['imports']
 base_result=read(BASE1575/'.build/runs/20261011T040211.744850Z/targets/current_connected/RESULT.json')
 tp=Path('$TRANSPORT/audit_transport.py');check(tp,'690c83dff9193a351c85ddca20e89429245e69e42a9a107b96de397212b30af8');sp=importlib.util.spec_from_file_location('explicit_transport',tp);t=importlib.util.module_from_spec(sp);sp.loader.exec_module(t)
 raw=t.read_audit(base_result['audit_receipt']['audit_output']);assert len(raw)==115316459 and digest_bytes(raw)=='9e9d0a7cae4f2feef7c0f1aeab323c13f0a937847e0510048ab2d95ad2cf18d2';b={x['name']:x for x in json.loads(raw)['declarations']};del raw;assert len(b)==101835
 ACCEPTED_RECEIPTS={r['module']:r for r in base_result['component_receipts']};records={}
 provider=[(SMOOTH,'.build/runs/20261011T043239.135086Z/targets/candidate_g3-smoothness/RESULT.json','5bf1613041a5b36b89b3cbe1e6f7ca662797b4a8d09ab31c8409b59da6143c19',['G3BernoulliSmoothness','G3BernoulliSmoothnessBoundaryChecks']), (G46,'.build/runs/20261011T061330.120140Z/targets/candidate_g46-frozen/RESULT.json','0fda31efdb23628408079c9fa6d01cc08c954a0381f4f691764897e51c115c7f',['G4LiteralLastChildExitCut','G4PartialExitSeparation','G6ErasedSelectedProjection']), (SUPPORT,'.build/runs/20261011T064842.285117Z/targets/candidate_g4-below-meeting/RESULT.json','69eaffd09e0febccb8404b0ec8f0607467a2e58443c55743a94f6df525479bd8',['G4ActualBelowMeetingSupport'])]
 for root,rpath,ah,names in provider:
  result=read(root/rpath);assert result['status']=='PASS';ap=Path(result['audit_receipt']['audit_output']);check(ap,ah)
  for x in read(ap)['declarations']:
   if x['name'] not in b:
    if x['name'] in records:assert records[x['name']]==x
    records[x['name']]=x
  for r in result['component_receipts']:
   if r['module'] in names:assert r['module'] not in ACCEPTED_RECEIPTS;ACCEPTED_RECEIPTS[r['module']]=r
 assert len(ACCEPTED_RECEIPTS)==1581 and len(records)==75 and sum(x['kind']=='theorem' for x in records.values())==54
 (OUT/'EXACT-NEW-DECLARATION-RECORDS.json').write_text(json.dumps(records,indent=2)+'\\n')
 expected={**b,**records};report=final_check(g,expected);assert report['audit_sha256']=='c87ba37f9362b9dbc995bcb24903cb710e6b538455f406260da14cccb1ddc9b1'
 report.update(graph_sha256=GRAPH,compiler_invoked=False,distinct_file_hashes=len(MEMO),bytes_hashed=hashed_bytes,elapsed_seconds=time.time()-start,archived_base_authenticated_reader=True)
 check(ROOT/'DEPENDENCY-GRAPH.json',GRAPH);(OUT/'FINAL-UNION-REVIEW.json').write_text(json.dumps(report,indent=2)+'\\n');print(json.dumps({k:v for k,v in report.items() if k!='component_records'},indent=2))
