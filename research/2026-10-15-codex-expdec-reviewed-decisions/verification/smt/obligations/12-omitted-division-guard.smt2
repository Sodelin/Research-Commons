; The partial function n/d is undefined at n=d=0; no SMT totalized division is used.
(set-option :timeout 2000)
(set-option :memory_max_size 192)
(set-option :produce-models true)
(set-logic QF_NRA)
(declare-const n Real)
(declare-const d Real)
(declare-const z Real)
(assert (= n 0))
(assert (= d 0))
(assert (= z 42))
(assert (= (* z d) n))
(check-sat)
(get-value (n d z))
