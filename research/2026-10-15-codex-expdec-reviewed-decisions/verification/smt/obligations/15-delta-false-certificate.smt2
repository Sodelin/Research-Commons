(set-option :timeout 2000)
(set-option :memory_max_size 192)
(set-option :produce-proofs true)
(set-logic QF_LRA)
(declare-const delta Real)
(declare-const r Real)
(declare-const rhat Real)
(assert (> delta 0))
(assert (<= (- rhat r) (/ delta 4)))
(assert (>= (- rhat r) (- (/ delta 4))))
(assert (< rhat (- (/ delta 2))))
; Negation of the promised exact falsity certificate.
(assert (>= r 0))
(check-sat)
(get-proof)
