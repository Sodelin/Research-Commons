; Explicit coefficient convolution, challenged by its negation.
(set-option :timeout 2000)
(set-option :memory_max_size 192)
(set-option :produce-proofs true)
(set-logic QF_NRA)
(declare-const a0 Real)
(declare-const a1 Real)
(declare-const b0 Real)
(declare-const b1 Real)
(declare-const x Real)
(assert (not (= (* (+ a0 (* a1 x)) (+ b0 (* b1 x)))
                (+ (* a0 b0) (* (+ (* a0 b1) (* a1 b0)) x) (* a1 b1 x x)))))
(check-sat)
(get-proof)
