(set-option :timeout 2000)
(set-option :memory_max_size 192)
(set-option :produce-models true)
(set-logic QF_NRA)
(declare-const x Real)
(declare-const y Real)
(declare-const a Real)
(declare-const b Real)
(assert (= a 1))
(assert (= b (- 1)))
(assert (= x y))
(assert (= (+ (* a x) (* b y)) 0))
(assert (or (not (= a 0)) (not (= b 0))))
(check-sat)
(get-value (a b x y))
