; U is an arbitrary formal basis value. No exponential axiom is asserted.
(set-option :timeout 2000)
(set-option :memory_max_size 192)
(set-option :produce-proofs true)
(set-logic QF_NRA)
(declare-const a0 Real)
(declare-const a1 Real)
(declare-const b0 Real)
(declare-const b1 Real)
(declare-const x Real)
(declare-const U Real)
(assert (not (= (+ (* (+ a0 (* a1 x)) U) (* (+ b0 (* b1 x)) U))
                (* (+ (+ a0 b0) (* (+ a1 b1) x)) U))))
(check-sat)
(get-proof)
