(set-option :timeout 2000)
(set-option :memory_max_size 192)
(set-option :produce-models true)
(set-logic QF_LRA)
(declare-const delta Real)
(declare-const r Real)
(declare-const rhat Real)
(assert (= delta 1))
(assert (= rhat (- (/ 1 2))))
(assert (= r (- (/ 3 4))))
(assert (<= (- rhat r) (/ delta 4)))
(assert (>= (- rhat r) (- (/ delta 4))))
(assert (>= rhat (- (/ delta 2))))
(assert (< r 0))
(check-sat)
(get-value (delta rhat r))
