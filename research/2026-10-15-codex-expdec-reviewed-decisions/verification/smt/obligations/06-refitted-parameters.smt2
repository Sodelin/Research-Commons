(set-option :timeout 2000)
(set-option :memory_max_size 192)
(set-option :produce-models true)
(set-logic QF_LRA)
(declare-const theta_1 Real)
(declare-const theta_2 Real)
(assert (and (> theta_1 0) (< theta_1 1) (> theta_2 0) (< theta_2 1)))
(assert (= theta_1 (/ 1 3)))
(assert (= theta_2 (/ 2 3)))
(check-sat)
(get-value (theta_1 theta_2))
