def WongGARG.GARG.AtLocus.{u, v} : {Node : Type u} →
  {Coord : Type v} →
    [inst : Fintype.{u} Node] →
      [inst_1 : LinearOrder.{v} Coord] → WongGARG.GARG.{u, v} Node Coord → Coord → Node → Node → Prop :=
fun {Node} {Coord} [Fintype.{u} Node] [LinearOrder.{v} Coord] G x parent child =>
  ∃ e,
    Membership.mem.{max u v, max u v} (WongGARG.GARG.records.{u, v} G) e ∧
      Eq.{u + 1} (WongGARG.EdgeRecord.parent.{u, v} e) parent ∧
        Eq.{u + 1} (WongGARG.EdgeRecord.child.{u, v} e) child ∧ WongGARG.EdgeRecord.Covers.{u, v} e x
