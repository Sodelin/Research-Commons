  {Coord : Type v} →
    [inst : Fintype.{u} Node] → [inst_1 : LinearOrder.{v} Coord] → WongGARG.GARG.{u, v} Node Coord → Coord → Prop :=
fun {Node} {Coord} [Fintype.{u} Node] [LinearOrder.{v} Coord] G x =>
  ∀ (child a b : Node),
    WongGARG.GARG.AtLocus.{u, v} G x a child → WongGARG.GARG.AtLocus.{u, v} G x b child → Eq.{u + 1} a b
def WongGARG.GARG.SampleAncestral.{u, v} : {Node : Type u} →
  {Coord : Type v} →
    [inst : Fintype.{u} Node] →
      [inst_1 : LinearOrder.{v} Coord] → WongGARG.GARG.{u, v} Node Coord → Coord → Node → Prop :=
fun {Node} {Coord} [Fintype.{u} Node] [LinearOrder.{v} Coord] G x a =>
  ∃ s,
    Membership.mem.{u, u} (WongGARG.GARG.samples.{u, v} G) s ∧
      (Eq.{u + 1} a s ∨ AncestryViews.Reach.{u} (WongGARG.GARG.AtLocus.{u, v} G x) a s)
def WongGARG.GARG.ExtractedAt.{u, v} : {Node : Type u} →
  {Coord : Type v} →
