fun {Node} {Coord} [Fintype.{u} Node] [LinearOrder.{v} Coord] G x parent child =>
  WongGARG.GARG.AtLocus.{u, v} G x parent child ∧ WongGARG.GARG.SampleAncestral.{u, v} G x child
def WongGARG.GARG.SampleSupported.{u, v} : {Node : Type u} →
