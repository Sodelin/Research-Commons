def WongRecordTracing.covers.{u, v} : {Node : Type u} →
  {Coord : Type v} → [inst : LinearOrder.{v} Coord] → WongGARG.EdgeRecord.{u, v} Node Coord → Coord → Bool :=
fun {Node} {Coord} [LinearOrder.{v} Coord] e x =>
  decide
    (∃ I,
      Membership.mem.{v, v} (WongGARG.EdgeRecord.regions.{u, v} e) I ∧
        LE.le.{v} (WongGARG.Interval.lo.{v} I) x ∧ LT.lt.{v} x (WongGARG.Interval.hi.{v} I))
