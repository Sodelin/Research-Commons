@ResearchCommons.Claims.WongRecordExtraction.abstract_counter_bounds.{u_1} : ∀ {Node : Type u_1}
  [inst : DecidableEq.{u_1 + 1} Node] [inst_1 : Fintype.{u_1} Node] (parent : Node → Option.{u_1} Node) (fuel : ℕ)
  (samples : List.{u_1} Node),
  have r := WongMemoizedTracing.run.{u_1} parent fuel samples fun x => none.{u_1};
  LE.le.{0} (WongMemoizedTracing.Result.writes.{u_1} r) (Fintype.card.{u_1} Node) ∧
    LE.le.{0} (WongMemoizedTracing.Result.checks.{u_1} r)
        (HAdd.hAdd.{0, 0, 0} (WongMemoizedTracing.Result.writes.{u_1} r) (List.length.{u_1} samples)) ∧
      LE.le.{0} (WongMemoizedTracing.Result.lookups.{u_1} r)
        (HAdd.hAdd.{0, 0, 0} (WongMemoizedTracing.Result.writes.{u_1} r) (List.length.{u_1} samples))
'ResearchCommons.Claims.WongRecordExtraction.abstract_counter_bounds' depends on axioms: [propext,
