Nanuq.GeneralRegionCrosscut.polygonal_crosscut_region {C P A₁ A₂ Ω : Set Schoenflies.Plane} {p q : Schoenflies.Plane}
  (hC : Schoenflies.IsJordanCurve C) (hcut : Schoenflies.IsCutPair C p q A₁ A₂) (hP : Schoenflies.IsArcBetween P p q)
  (hpoly : Schoenflies.IsPolygonal P) (hPC : P ∩ C = {p, q}) (hΩ : Schoenflies.IsRegionOf C Ω) (hPD : P \ {p, q} ⊆ Ω) :
  ∃ V₁ V₂,
    Schoenflies.IsRegionOf (A₁ ∪ P) V₁ ∧
      Schoenflies.IsRegionOf (A₂ ∪ P) V₂ ∧
        Ω \ P = V₁ ∪ V₂ ∧
          Disjoint V₁ V₂ ∧
            V₁.Nonempty ∧
              V₂.Nonempty ∧
                V₁ ≠ V₂ ∧
                  (∀ z ∈ V₁, connectedComponentIn (Ω \ P) z = V₁) ∧
                    (∀ z ∈ V₂, connectedComponentIn (Ω \ P) z = V₂) ∧ closure V₁ ∩ C = A₁ ∧ closure V₂ ∩ C = A₂
'Nanuq.GeneralRegionCrosscut.polygonal_crosscut_region' depends on axioms: [propext, Classical.choice, Quot.sound]
Nanuq.PrescribedLoopAmbient.loop_parameters {f g : ℝ → Schoenflies.Plane} (hf : Schoenflies.IsLoop f)
  (hg : Schoenflies.IsLoop g) : ∃ H, (∀ t ∈ unitInterval, H (f t) = g t) ∧ ∀ T ⊆ unitInterval, ⇑H '' f '' T = g '' T
'Nanuq.PrescribedLoopAmbient.loop_parameters' depends on axioms: [propext, Classical.choice, Quot.sound]
Nanuq.PrescribedLoopAmbient.image_lower_half (f g : ℝ → Schoenflies.Plane) :
  Schoenflies.concatenate f g '' Schoenflies.lowerHalf = f '' unitInterval
'Nanuq.PrescribedLoopAmbient.image_lower_half' depends on axioms: [propext, Classical.choice, Quot.sound]
Nanuq.PrescribedLoopAmbient.image_upper_half (f g : ℝ → Schoenflies.Plane) (hm : f 1 = g 0) :
  Schoenflies.concatenate f g '' Schoenflies.upperHalf = g '' unitInterval
'Nanuq.PrescribedLoopAmbient.image_upper_half' depends on axioms: [propext, Classical.choice, Quot.sound]
Nanuq.PrescribedLoopAmbient.cycle_arc_straightening {P Q : Set Schoenflies.Plane} {p q : Schoenflies.Plane}
  (hP : Schoenflies.IsArcBetween P p q) (hQ : Schoenflies.IsArcBetween Q q p) (hmeet : ∀ z ∈ P, z ∈ Q → z = p ∨ z = q) :
  ∃ H,
    ⇑H '' P = Schoenflies.sideTop ∪ Schoenflies.sideLeft ∧
      ⇑H '' Q = Schoenflies.sideBottom ∪ Schoenflies.sideRight ∧
        H p = Schoenflies.cornerNE ∧ H q = Schoenflies.cornerSW ∧ Schoenflies.IsPolygonal (⇑H '' P)
'Nanuq.PrescribedLoopAmbient.cycle_arc_straightening' depends on axioms: [propext, Classical.choice, Quot.sound]
