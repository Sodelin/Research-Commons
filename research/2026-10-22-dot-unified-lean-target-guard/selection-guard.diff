+ elif requested == 'accepted':
+  labels = [k for k,v in targets.items() if v.get('required_for_accepted_release',True)]
+ elif requested == 'provisional':
+  labels = [k for k,v in targets.items() if not v.get('required_for_accepted_release',True)]
+ else:
+  labels = [requested]
+ if not labels:
+  raise ValueError('EMPTY_TARGET_SELECTION: '+requested)
+ if len(labels) != len(set(labels)) or any(k not in targets for k in labels):
+  raise ValueError('INVALID_TARGET_SELECTION: '+requested)
+ return labels
