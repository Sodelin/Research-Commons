fun {Label} {V} p m x y b =>
  Eq.{1} (↑(Sigma.snd.{u, 0} x)) 0 ∧
    GenericUniversalAvoiders.Population.edge.{u, w} p (Sigma.fst.{u, 0} x) (Sigma.fst.{u, 0} y) b
structure PopulationCounting.InfiniteLabeledPopulation (k d : ℕ) : Type
number of parameters: 2
fields:
  PopulationCounting.InfiniteLabeledPopulation.edge : ℕ → ℕ → Option.{0} ℕ
  PopulationCounting.InfiniteLabeledPopulation.root : ℕ → Bool
  PopulationCounting.InfiniteLabeledPopulation.birth_order : ∀ (u v : ℕ),
      Eq.{1} (Option.isSome.{0} (self.edge u v)) true → LT.lt.{0} u v
  PopulationCounting.InfiniteLabeledPopulation.root_no_parents : ∀ (v : ℕ),
      Eq.{1} (self.root v) true → ∀ (u : ℕ), Eq.{1} (self.edge u v) none.{0}
  PopulationCounting.InfiniteLabeledPopulation.parent_of_label : ∀ (v : ℕ),
      Eq.{1} (self.root v) false → ∀ (l : ℕ), LT.lt.{0} l k → ∃ u, Eq.{1} (self.edge u v) (some.{0} l)
  PopulationCounting.InfiniteLabeledPopulation.childSupport : ℕ → ℕ
  PopulationCounting.InfiniteLabeledPopulation.no_children_after : ∀ (u v : ℕ),
      LE.le.{0} (self.childSupport u) v → Eq.{1} (self.edge u v) none.{0}
  PopulationCounting.InfiniteLabeledPopulation.child_cap : ∀ (u : ℕ),
      LE.le.{0} (PopulationCounting.sumBelow (self.childSupport u) fun v => PopulationCounting.edgeBit (self.edge u v))
        d
  PopulationCounting.InfiniteLabeledPopulation.rootSupport : ℕ
  PopulationCounting.InfiniteLabeledPopulation.no_roots_after : ∀ (v : ℕ),
      LE.le.{0} self.rootSupport v → Eq.{1} (self.root v) false
constructor:
  PopulationCounting.InfiniteLabeledPopulation.mk {k d : ℕ} (edge : ℕ → ℕ → Option.{0} ℕ) (root : ℕ → Bool)
    (birth_order : ∀ (u v : ℕ), Eq.{1} (Option.isSome.{0} (edge u v)) true → LT.lt.{0} u v)
    (root_no_parents : ∀ (v : ℕ), Eq.{1} (root v) true → ∀ (u : ℕ), Eq.{1} (edge u v) none.{0})
    (parent_of_label :
      ∀ (v : ℕ), Eq.{1} (root v) false → ∀ (l : ℕ), LT.lt.{0} l k → ∃ u, Eq.{1} (edge u v) (some.{0} l))
    (childSupport : ℕ → ℕ) (no_children_after : ∀ (u v : ℕ), LE.le.{0} (childSupport u) v → Eq.{1} (edge u v) none.{0})
    (child_cap :
      ∀ (u : ℕ),
        LE.le.{0} (PopulationCounting.sumBelow (childSupport u) fun v => PopulationCounting.edgeBit (edge u v)) d)
    (rootSupport : ℕ) (no_roots_after : ∀ (v : ℕ), LE.le.{0} rootSupport v → Eq.{1} (root v) false) :
    PopulationCounting.InfiniteLabeledPopulation k d
def InfiniteConservation.crossingCount : {k d : ℕ} → PopulationCounting.InfiniteLabeledPopulation k d → ℕ → ℕ :=
fun {k d} p n =>
  PopulationCounting.sumBelow n fun u =>
    PopulationCounting.sumBelow (p.childSupport u) fun v =>
      ite.{1} (LE.le.{0} n v) (PopulationCounting.edgeBit (p.edge u v)) 0
def PopulationCounting.fullRootCount : {k d : ℕ} → PopulationCounting.InfiniteLabeledPopulation k d → ℕ :=
fun {k d} p => PopulationCounting.sumBelow p.rootSupport fun v => ite.{1} (Eq.{1} (p.root v) true) 1 0
structure BirthOrder.OrderedEnumeration.{u, v} {V : Type u} {Time : Type v} [LE.{v} Time] (birth : V → Time) : Type u
number of parameters: 4
fields:
  BirthOrder.OrderedEnumeration.toFun.{u, v} : ℕ → V
  BirthOrder.OrderedEnumeration.injective.{u,
    v} : ∀ (i j : ℕ),
      Eq.{u + 1} (BirthOrder.OrderedEnumeration.toFun.{u, v} self i)
          (BirthOrder.OrderedEnumeration.toFun.{u, v} self j) →
        Eq.{1} i j
