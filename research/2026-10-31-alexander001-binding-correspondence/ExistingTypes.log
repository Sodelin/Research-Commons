  GenericUniversalAvoiders.Population.sublevels.{u,
    w} : ∀ (r : ℝ),
      BirthOrder.FiniteCover.{u} fun x => LE.le.{0} (GenericUniversalAvoiders.Population.birth.{u, w} self x) r
  GenericUniversalAvoiders.Population.chronological.{u,
    w} : ∀ (x y : V) (b : Label),
      GenericUniversalAvoiders.Population.edge.{u, w} self x y b →
        LT.lt.{0} (GenericUniversalAvoiders.Population.birth.{u, w} self x)
          (GenericUniversalAvoiders.Population.birth.{u, w} self y)
  GenericUniversalAvoiders.Population.unique.{u,
    w} : ∀ (x y : V) (a b : Label),
      GenericUniversalAvoiders.Population.edge.{u, w} self x y a →
        GenericUniversalAvoiders.Population.edge.{u, w} self x y b → Eq.{w + 1} a b
  GenericUniversalAvoiders.Population.roots.{u,
    w} : BirthOrder.FiniteCover.{u} fun y =>
      ∀ (x : V) (b : Label), ¬GenericUniversalAvoiders.Population.edge.{u, w} self x y b
  GenericUniversalAvoiders.Population.children.{u,
    w} : ∀ (x : V), BirthOrder.FiniteCover.{u} fun y => ∃ b, GenericUniversalAvoiders.Population.edge.{u, w} self x y b
  GenericUniversalAvoiders.Population.parents.{u,
    w} : ∀ (y : V),
      (¬∀ (x : V) (b : Label), ¬GenericUniversalAvoiders.Population.edge.{u, w} self x y b) →
        ∀ (b : Label), ∃ x, GenericUniversalAvoiders.Population.edge.{u, w} self x y b
constructor:
  GenericUniversalAvoiders.Population.mk.{u, w} {V : Type u} {Label : Type w} (edge : V → V → Label → Prop)
    (birth : V → ℝ) (infinite : BirthOrder.InfiniteVertices.{u} V)
    (sublevels : ∀ (r : ℝ), BirthOrder.FiniteCover.{u} fun x => LE.le.{0} (birth x) r)
    (chronological : ∀ (x y : V) (b : Label), edge x y b → LT.lt.{0} (birth x) (birth y))
    (unique : ∀ (x y : V) (a b : Label), edge x y a → edge x y b → Eq.{w + 1} a b)
    (roots : BirthOrder.FiniteCover.{u} fun y => ∀ (x : V) (b : Label), ¬edge x y b)
    (children : ∀ (x : V), BirthOrder.FiniteCover.{u} fun y => ∃ b, edge x y b)
    (parents : ∀ (y : V), (¬∀ (x : V) (b : Label), ¬edge x y b) → ∀ (b : Label), ∃ x, edge x y b) :
    GenericUniversalAvoiders.Population.{u, w} V Label
def GenericUniversalAvoiders.blowUp.{u, w} : {Label : Type w} →
  {V : Type u} →
    GenericUniversalAvoiders.Population.{u, w} V Label →
      (m : V → ℕ) →
        (∀ (x : V), LT.lt.{0} 0 (m x)) →
          GenericUniversalAvoiders.Population.{u, w} (GenericUniversalAvoiders.Fibre.{u} V m) Label :=
fun {Label} {V} p m hm =>
  GenericUniversalAvoiders.Population.mk.{u, w} (GenericUniversalAvoiders.liftedEdge.{u, w} p m)
    (fun x => GenericUniversalAvoiders.Population.birth.{u, w} p (Sigma.fst.{u, 0} x)) ⋯ ⋯ ⋯ ⋯ ⋯ ⋯ ⋯
def GenericUniversalAvoiders.PreservesEdges.{u, v, w} : {Label : Type w} →
  {V : Type u} →
    {W : Type v} →
      GenericUniversalAvoiders.Population.{u, w} V Label →
        GenericUniversalAvoiders.LocallyFiniteHost.{v} W → (V → W) → Prop :=
fun {Label} {V} {W} p H f =>
  ∀ (x y : V) (b : Label),
    GenericUniversalAvoiders.Population.edge.{u, w} p x y b →
      GenericUniversalAvoiders.LocallyFiniteHost.adjacent.{v} H (f x) (f y)
