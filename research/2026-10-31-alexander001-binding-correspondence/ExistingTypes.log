  BirthOrder.OrderedEnumeration.mk.{u, v} {V : Type u} {Time : Type v} [LE.{v} Time] {birth : V → Time} (toFun : ℕ → V)
    (injective : ∀ (i j : ℕ), Eq.{u + 1} (toFun i) (toFun j) → Eq.{1} i j)
    (surjective : ∀ (x : V), ∃ n, Eq.{u + 1} (toFun n) x)
    (nondecreasing : ∀ (i j : ℕ), LE.le.{0} i j → LE.le.{v} (birth (toFun i)) (birth (toFun j))) :
    BirthOrder.OrderedEnumeration.{u, v} birth
