fun {Label} {V} p m hm =>
  GenericUniversalAvoiders.Population.mk.{u, w} (TerminalCloneAvoiders.terminalEdge.{u, w} p m)
    (fun x => GenericUniversalAvoiders.Population.birth.{u, w} p (Sigma.fst.{u, 0} x)) ⋯ ⋯ ⋯ ⋯ ⋯ ⋯ ⋯
def TerminalCloneAvoiders.terminalEdge.{u, w} : {Label : Type w} →
  {V : Type u} →
    GenericUniversalAvoiders.Population.{u, w} V Label →
