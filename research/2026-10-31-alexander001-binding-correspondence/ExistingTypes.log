structure GenericUniversalAvoiders.Population.{u, w} (V : Type u) (Label : Type w) : Type (max u w)
number of parameters: 2
fields:
  GenericUniversalAvoiders.Population.edge.{u, w} : V → V → Label → Prop
  GenericUniversalAvoiders.Population.birth.{u, w} : V → ℝ
