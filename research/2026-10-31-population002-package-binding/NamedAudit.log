@ResearchCommons.Claims.CriticalTailPorts.persistent_minimum_tail : ∀ {k : ℕ}
  (p : PopulationCounting.InfiniteLabeledPopulation k k) (start : ℕ),
  LE.le.{0} p.rootSupport start →
    (∀ (n : ℕ),
        LE.le.{0} start n → Eq.{1} (InfiniteConservation.crossingCount p n) (InfiniteConservation.triangular k)) →
      ∀ (u : ℕ),
        LE.le.{0} start u →
          ∀ (v : ℕ),
            Eq.{1} (Option.isSome.{0} (p.edge u v)) true ↔ LT.lt.{0} u v ∧ LE.le.{0} v (HAdd.hAdd.{0, 0, 0} u k)
