@Nanuq.Pendant.actual_leaf_one_exit_cap.{u_1} : ∀ {E : Type u_1} {G : Graph.{0, u_1} Schoenflies.Plane E}
  [Graph.Finite.{0, u_1} G] {drawing : E → ℝ → Schoenflies.Plane},
  Graph.IsDrawing.{u_1} G drawing →
    ∀ {e : E} {v w : Schoenflies.Plane},
      Graph.IsLink.{0, u_1} G e v w →
        (∀ (g : E),
            Membership.mem.{u_1, u_1} (Graph.edgeSet.{0, u_1} G) g → Graph.Inc.{0, u_1} G g v → Eq.{u_1 + 1} g e) →
          ∀ (f : ℝ → Schoenflies.Plane),
            ContinuousOn.{0, 0} f unitInterval →
              Set.InjOn.{0, 0} f unitInterval →
                Eq.{1} (Set.image.{0, 0} f unitInterval) (Graph.edgeArc.{u_1} drawing e) →
                  Eq.{1} (f 0) v →
                    Eq.{1} (f 1) w →
                      ∃ H r b t C,
                        LT.lt.{0} 0 r ∧
                          LT.lt.{0} r b ∧
                            Membership.mem.{0, 0} (Set.Ioo.{0} (1 / 2) (13 / 24)) t ∧
                              Schoenflies.IsJordanCurve C ∧
                                (∀ (y : ℝ),
                                    LT.lt.{0} (abs.{0} y) r → Membership.mem.{0, 0} C (Schoenflies.Plane.mk r y)) ∧
                                  Eq.{1} (H (f (1 / 2))) 0 ∧
                                    Eq.{1} (H (f (13 / 24))) (Schoenflies.Plane.mk b 0) ∧
                                      Eq.{1} (H (f t)) (Schoenflies.Plane.mk r 0) ∧
                                        Eq.{1}
                                            (Set.image.{0, 0} (⇑H) (Set.image.{0, 0} f (Set.Icc.{0} (1 / 2) (13 / 24))))
                                            (segment.{0, 0} ℝ 0 (Schoenflies.Plane.mk b 0)) ∧
                                          Eq.{1}
                                              (Inter.inter.{0} C
                                                (Set.image.{0, 0} (⇑H) (Graph.pointSet.{u_1} G drawing)))
                                              (singleton.{0, 0} (Schoenflies.Plane.mk r 0)) ∧
                                            Eq.{1}
                                                (Inter.inter.{0} (Union.union.{0} C (Schoenflies.inside C))
                                                  (Set.image.{0, 0} (⇑H) (Graph.pointSet.{u_1} G drawing)))
                                                (Set.image.{0, 0} (⇑H) (Set.image.{0, 0} f (Set.Icc.{0} 0 t))) ∧
                                              Membership.mem.{0, 0}
                                                  (sdiff.{0} C (Set.image.{0, 0} (⇑H) (Graph.pointSet.{u_1} G drawing)))
                                                  (Schoenflies.Plane.mk r (HDiv.hDiv.{0, 0, 0} r 2)) ∧
                                                Membership.mem.{0, 0}
                                                    (sdiff.{0} C
                                                      (Set.image.{0, 0} (⇑H) (Graph.pointSet.{u_1} G drawing)))
                                                    (Schoenflies.Plane.mk r (HDiv.hDiv.{0, 0, 0} (Neg.neg.{0} r) 2)) ∧
                                                  Membership.mem.{0, 0}
                                                    (connectedComponentIn.{0}
                                                      (compl.{0}
                                                        (Set.image.{0, 0} (⇑H) (Graph.pointSet.{u_1} G drawing)))
                                                      (Schoenflies.Plane.mk r (HDiv.hDiv.{0, 0, 0} r 2)))
                                                    (Schoenflies.Plane.mk r (HDiv.hDiv.{0, 0, 0} (Neg.neg.{0} r) 2))
'Nanuq.Pendant.actual_leaf_one_exit_cap' depends on axioms: [propext, Classical.choice.{u}, Quot.sound.{u}]
