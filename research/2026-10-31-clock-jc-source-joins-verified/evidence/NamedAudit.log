                (UnifiedLean.Source.UniformizedSourceStep.stepDestination N s (some p))
                z.2) ∂((ENNReal.ofReal
                      (UnifiedLean.Source.UniformizedSourceStep.choiceRate N r s p /
                        UnifiedLean.Source.UniformizedSourceStep.totalRate N r s) •
                    ProbabilityTheory.expMeasure (UnifiedLean.Source.UniformizedSourceStep.totalRate N r s)).restrict
