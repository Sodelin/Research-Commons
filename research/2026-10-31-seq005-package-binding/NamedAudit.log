ResearchCommons.Claims.FiniteEditOptimum.integer_allowance_iff : ∀ (s : Nat → Bool) (m : Nat),
  FiniteEditStability.AgreeFrom s ThueMorseBits.t m →
    ∀ (B : Int),
      (∀ (v len : Nat),
          LE.le.{0} 1 v →
            FiniteEditStability.IsMaximumPrefix s v len →
              LE.le.{0} (HMul.hMul.{0, 0, 0} 3 ↑len) (HAdd.hAdd.{0, 0, 0} (HMul.hMul.{0, 0, 0} 8 ↑v) B)) ↔
        LE.le.{0} (FiniteEditAlgorithm.best s m (HSub.hSub.{0, 0, 0} (FiniteEditAlgorithm.cutoff m) 1)) B
'ResearchCommons.Claims.FiniteEditOptimum.integer_allowance_iff' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
ResearchCommons.Claims.FiniteEditOptimum.allowance_bounds : ∀ (s : Nat → Bool) (m : Nat),
  FiniteEditStability.AgreeFrom s ThueMorseBits.t m →
    LE.le.{0} (-1) (FiniteEditAlgorithm.best s m (HSub.hSub.{0, 0, 0} (FiniteEditAlgorithm.cutoff m) 1)) ∧
      LE.le.{0} (FiniteEditAlgorithm.best s m (HSub.hSub.{0, 0, 0} (FiniteEditAlgorithm.cutoff m) 1))
        (HSub.hSub.{0, 0, 0} (HMul.hMul.{0, 0, 0} 8 ↑m) 1)
'ResearchCommons.Claims.FiniteEditOptimum.allowance_bounds' depends on axioms: [propext,
 Classical.choice.{u},
 Quot.sound.{u}]
ResearchCommons.Claims.FiniteEditOptimum.maximum_iff_actual_height : ∀ (s : Nat → Bool) (m : Nat),
  FiniteEditStability.AgreeFrom s ThueMorseBits.t m →
    ∀ (v len : Nat), FiniteEditStability.IsMaximumPrefix s v len ↔ Eq.{1} len (FiniteEditExact.height s m v)
