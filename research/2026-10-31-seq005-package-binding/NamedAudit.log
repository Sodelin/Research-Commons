ResearchCommons.Claims.FiniteEditOptimum.actual_height : ∀ (s : Nat → Bool) (m : Nat),
  FiniteEditStability.AgreeFrom s ThueMorseBits.t m →
    ∀ (v : Nat), FiniteEditStability.IsMaximumPrefix s v (FiniteEditExact.height s m v)
'ResearchCommons.Claims.FiniteEditOptimum.actual_height' depends on axioms: [propext,
 Classical.choice.{u},
