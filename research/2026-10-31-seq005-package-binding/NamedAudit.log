ResearchCommons.Claims.FiniteEditOptimum.cutoff_formula : ∀ (m : Nat),
  Eq.{1} (FiniteEditAlgorithm.cutoff m)
    (HAdd.hAdd.{0, 0, 0} (HMul.hMul.{0, 0, 0} 3 (HPow.hPow.{0, 0, 0} 2 (HAdd.hAdd.{0, 0, 0} m 3))) m)
'ResearchCommons.Claims.FiniteEditOptimum.cutoff_formula' does not depend on any axioms
ResearchCommons.Claims.FiniteEditOptimum.finite_maximum : ∀ (s : Nat → Bool) (m : Nat),
  (∀ (v : Nat),
      LE.le.{0} 1 v →
        LE.le.{0} v (FiniteEditAlgorithm.cutoff m) →
          LE.le.{0} (FiniteEditAlgorithm.residual s m v)
            (FiniteEditAlgorithm.best s m (HSub.hSub.{0, 0, 0} (FiniteEditAlgorithm.cutoff m) 1))) ∧
    Exists.{1} fun v =>
      LE.le.{0} 1 v ∧
        LE.le.{0} v (FiniteEditAlgorithm.cutoff m) ∧
          Eq.{1} (FiniteEditAlgorithm.residual s m v)
            (FiniteEditAlgorithm.best s m (HSub.hSub.{0, 0, 0} (FiniteEditAlgorithm.cutoff m) 1))
'ResearchCommons.Claims.FiniteEditOptimum.finite_maximum' depends on axioms: [propext, Quot.sound.{u}]
ResearchCommons.Claims.FiniteEditOptimum.global_optimum : ∀ (s : Nat → Bool) (m : Nat),
