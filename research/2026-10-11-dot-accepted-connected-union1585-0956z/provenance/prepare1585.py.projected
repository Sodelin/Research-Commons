"""Measured additive staging only; no compiler. Run after capacity authorization."""
from pathlib import Path
import json,hashlib,shutil,os
R=Path(__file__).resolve().parent
B=Path('$ACCEPTED1581')
G=Path('$SHARED_WORKSPACE/g7-restoration-check-20261011-0842z')
O=Path('$PACKAGE')
cap=64*2**20;floor=20*2**30
sha=lambda p:hashlib.sha256(p.read_bytes()).hexdigest()
plan=json.loads((R/'ASSESSMENT.json').read_text());assert plan['mathematical_target_count']==1585
start=shutil.disk_usage(B).free;assert start>floor+cap;assert not O.exists();O.mkdir();newfiles=[]
def guard():
 used=sum(p.stat().st_blocks*512 for p in newfiles if p.exists());f=shutil.disk_usage(O).free
 assert used<=cap and start-f<=cap and f>floor
 return used,f
def copy(p,q):
 guard();q.parent.mkdir(parents=True,exist_ok=True);shutil.copyfile(p,q);newfiles.append(q);guard()
def write(q,x):
 guard();q.parent.mkdir(parents=True,exist_ok=True);q.write_text(json.dumps(x,indent=2)+'\n');newfiles.append(q);guard()
def link(p,q):
 guard();q.parent.mkdir(parents=True,exist_ok=True);os.link(p,q);guard()
g=json.loads((B/'DEPENDENCY-GRAPH.json').read_text());assert sha(B/'DEPENDENCY-GRAPH.json')==plan['accepted_base_graph_sha256']
base=g['targets']['current/connected'];g['targets']['history/accepted1581']=json.loads(json.dumps(base));add={x['module']:x for x in plan['new_mathematical_modules']}
for n,x in add.items():
 p=Path(x['path']);assert sha(p)==x['sha256'] and n not in base['modules']
 base['modules'][n]={k:x[k] for k in ('module','sha256','imports')};base['order'].append(n);base['roots'].append(n)
assert len(base['modules'])==1585
seen=set()
for n in base['order']:
 assert all(i in seen or i not in base['modules'] for i in base['modules'][n]['imports']);seen.add(n)
base['external_imports']=sorted({i for x in base['modules'].values() for i in x['imports'] if i not in base['modules']})
for name,t in json.loads((G/'DEPENDENCY-GRAPH.json').read_text())['targets'].items():
 assert name not in g['targets'];g['targets'][name]=t
allmods=dict(base['modules'])
for t in g['targets'].values():
 for n,x in t['modules'].items():
  if n in allmods:assert allmods[n]['sha256']==x['sha256'] and allmods[n]['imports']==x['imports']
  else:allmods[n]=x
assert set(allmods)-set(base['modules'])=={'G7OriginalPopulationFixture'}
g['scope']='Prospective exact accepted1581 plus restored EncodedMergerSupport and three static-reviewed proof consumers. Fixture global main remains a separate checked target. Current combined acceptance pending.'
write(O/'DEPENDENCY-GRAPH.json',g)
for n,x in allmods.items():
 p=Path(add[n]['path']) if n in add else (G if n=='G7OriginalPopulationFixture' else B)/'source-store'/(x['sha256']+'.lean')
 assert sha(p)==x['sha256'];link(p,O/'source-store'/(x['sha256']+'.lean'))
for p in (B/'scripts').iterdir():
 if p.is_file():copy(p,O/'scripts'/p.name)
for n in ['lakefile.lean','lean-toolchain','lake-manifest.json']:copy(B/n,O/n)
found=set();records=[]
for origin in [B,G]:
 for p in (origin/'.build/cache').glob('*/receipt.json'):
  r=json.loads(p.read_text());n=r['module']
  if n in found or n not in allmods or r['source_sha256']!=allmods[n]['sha256']:continue
  if origin==G and n not in ('G7EncodedMergerSupport','G7OriginalPopulationFixture'):continue
  assert r['exit_code']==0 and r['source_and_imports_stable'];dest=O/'.build/cache'/p.parent.name
  for q in p.parent.iterdir():
   if q.is_file():
    if q.name=='receipt.json':copy(q,dest/q.name)
    else:link(q,dest/q.name)
  found.add(n);records.append({'module':n,'key':p.parent.name,'receipt_sha256':sha(p),'source_sha256':r['source_sha256'],'object_sha256':r['object_sha256'],'accepted_origin':origin.name,'original_receipt_path':str(p)})
missing=set(base['modules'])-found
assert missing=={'G4ActualCommonPrefixSelector','G4ActualColocatedCompletion','G3FiniteWordLogSignature'}
assert len(found)==1583 and len(found&set(base['modules']))==1582
write(O/'AUTHENTICATED-ADDITIVE-PREFLIGHT.json',{'status':'PREPARED_REQUIRES_INDEPENDENT_PREFLIGHT','records':records,'selected_expected_reuse':1582,'fresh_math_sources':sorted(missing),'isolated_fixture_reuse':1,'source_plan':plan,'foreign_compiled_objects_admitted':False})
for n in ['DEPENDENCY-GRAPH.json','PUBLICATION-RECEIPT.json']:copy(B/n,O/'provenance'/('accepted1581-'+n))
for n in ['DEPENDENCY-GRAPH.json','PUBLICATION-RECEIPT.json']:copy(G/n,O/'provenance'/('acceptedG7fixture-'+n))
copy(R/'ASSESSMENT.json',O/'provenance/ASSESSMENT.json');copy(Path(__file__),O/'provenance/prepare1585.py')
write(O/'PREPARATION.json',{'status':'PREPARED_PENDING_REVIEW_NO_COMPILER','graph_sha256':sha(O/'DEPENDENCY-GRAPH.json'),'selected_math_modules':1585,'total_distinct_bodies':1586,'fresh_selected_sources':3,'reused_selected_components':1582,'fixture_main_isolated':True,'scripts':{p.name:sha(p) for p in (O/'scripts').iterdir() if p.is_file()}})
used,f=guard();write(O/'STAGING-BUDGET-RECEIPT.json',{'status':'PASS_HARD_64MIB_PREPARATION','start_free':start,'end_free':f,'observed_consumption':start-f,'new_regular_file_allocation':used,'preparation_cap':cap,'launch_threshold':floor,'compiler_invoked':False})
print(json.dumps({'path':str(O),'graph_sha256':sha(O/'DEPENDENCY-GRAPH.json'),'used':used,'free':f}))
