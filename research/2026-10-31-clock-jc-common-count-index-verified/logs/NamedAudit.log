@ResearchCommons.MSCI.JC69CommonCountIndex.actual_common_index_card_le : ∀ {V : Type u_1} {E : Type u_2}
  {Copy : Type u_3} {X : Type u_4} [inst : DecidableEq V] [inst_1 : DecidableEq E] [inst_2 : Fintype V]
  [inst_3 : Fintype E] [inst_4 : Fintype X] [inst_5 : DecidableEq Copy] [inst_6 : Fintype Copy] [Nonempty Copy]
  (e : Copy ≃ Fin (Fintype.card Copy)) (N : Nanuq.Source.RootedBinary V E X) {sample : Copy → X} (fuel : ℕ)
  (s : UnifiedLean.Source.UniformizedSourceStep.Code N sample),
  Fintype.card (ResearchCommons.MSCI.JC69CommonCountIndex.CommonTermIndex e N fuel s) ≤
    Fintype.card Copy * ∑ k ∈ Finset.range (Fintype.card Copy), (Fintype.card Copy).choose 2 ^ k
