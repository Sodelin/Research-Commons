@ResearchCommons.MSCI.JC69CommonCountIndex.actual_common_index_expansion : ∀ {V : Type u_1} {E : Type u_2}
  {Copy : Type u_3} {X : Type u_4} [inst : DecidableEq V] [inst_1 : DecidableEq E] [inst_2 : Fintype V]
  [inst_3 : Fintype E] [inst_4 : Fintype X] [inst_5 : DecidableEq Copy] [inst_6 : Fintype Copy] {n : ℕ}
  (e : Copy ≃ Fin n) (N : Nanuq.Source.RootedBinary V E X) {sample : Copy → X}
  (r : UnifiedLean.Source.NativePairClockLaw.PositivePairRates E) (L : ℕ)
  (q : Fin L → Copy → ResearchCommons.MSCI.JC69.Base) (fuel : ℕ)
  (s : UnifiedLean.Source.UniformizedSourceStep.Code N sample) (T : NNReal)
  (target : ResearchCommons.MSCI.JC69EndpointWeight.BlockPopulationObservation Copy V E),
  (ResearchCommons.MSCI.JC69EndpointWeight.actualResolvedWeight N r L q fuel s (↑T) target).toReal =
    ∑ i,
      ResearchCommons.MSCI.JC69CommonCountIndex.commonCoefficient e N r L q fuel s target i *
        Real.exp (-ResearchCommons.MSCI.JC69CommonCountIndex.commonRate e N r L q fuel s i * ↑T)
