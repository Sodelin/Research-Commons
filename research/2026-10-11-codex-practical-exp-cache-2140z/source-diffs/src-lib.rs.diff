+impl ExpCache {
+    pub fn new(capacity: usize, max_key_bits: u64) -> Self {
+        Self { capacity, max_key_bits, values: HashMap::new(), order: VecDeque::new(), stats: CacheStats::default() }
+    }
+    pub fn stats(&self) -> CacheStats { self.stats }
+    pub fn len(&self) -> usize { self.values.len() }
+    pub fn is_empty(&self) -> bool { self.values.is_empty() }
+    pub fn exp_neg(&mut self, x: &Rational, bits: i32) -> Result<ForwardInterval> {
+        // Validation precedes even key construction; invalid requests cannot hit.
+        if x.is_negative() || !(8..=192).contains(&bits) {
+            return error("exponential domain/precision");
+        }
+        if self.capacity == 0 || bit_size(x) > self.max_key_bits {
+            self.stats.bypasses = self.stats.bypasses.saturating_add(1);
+            return exp_neg_work(x, bits, &mut self.stats.work);
+        }
+        let key = ExpKey { x: x.clone(), bits, policy: EXP_POLICY };
+        if let Some(value) = self.values.get(&key) {
+            self.stats.hits = self.stats.hits.saturating_add(1);
+            return Ok(value.clone());
+        }
+        self.stats.misses = self.stats.misses.saturating_add(1);
+        let value = exp_neg_work(x, bits, &mut self.stats.work)?;
+        if self.values.len() == self.capacity {
+            let oldest = self.order.pop_front().expect("FIFO/cache cardinality invariant");
+            self.values.remove(&oldest);
+            self.stats.evictions = self.stats.evictions.saturating_add(1);
+        }
+        self.order.push_back(key.clone());
+        self.values.insert(key, value.clone());
+        Ok(value)
+    }
