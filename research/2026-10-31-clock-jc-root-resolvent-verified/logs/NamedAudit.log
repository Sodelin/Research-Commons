 Classical.choice,
 Quot.sound]
@ResearchCommons.MSCI.JC69RootResolvent.actual_root_resolvent : ∀ {V : Type u_1} {E : Type u_2} {Copy : Type u_3}
  {X : Type u_4} [inst : DecidableEq V] [inst_1 : DecidableEq E] [inst_2 : Fintype V] [inst_3 : Fintype E]
  [inst_4 : Fintype X] [inst_5 : DecidableEq Copy] [inst_6 : Fintype Copy] [Nonempty Copy]
  (N : Nanuq.Source.RootedBinary V E X) {sample : Copy → X}
  (r : UnifiedLean.Source.NativePairClockLaw.PositivePairRates E) (L : ℕ)
  (q : Fin L → Copy → ResearchCommons.MSCI.JC69.Base),
  (∀ (j : Fin L), ∑ x, q j x = 0) →
    ∀ (s : UnifiedLean.Source.UniformizedSourceStep.Code N sample),
      UnifiedLean.Source.SourceAncestralCompletion.AncestralRoot N s →
        1 < UnifiedLean.Source.SourceActualHoldingClocks.liveCard s →
          ResearchCommons.MSCI.JC69RootResolvent.rootWeight N r L q s =
