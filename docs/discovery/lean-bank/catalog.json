  "problems": [
    {
      "id": "problem.alexander.zero-run",
      "title": "Alexander isolated zero-run exact component",
      "statement": "@ResearchCommons.TriangleRun.exact_component : ∀ {twist : Nat → Bool}\n  {keep : ResearchCommons.TwoLiftTriangle.Vertex → Prop} (lo m : Nat),\n  0 < lo →\n    (∀ (n : Nat), lo ≤ n → n ≤ lo + m → twist n = Bool.false) →\n      (∀ (n : Nat), 0 < n → lo ≤ n + 2 → n ≤ lo + m + 2 → n < lo ∨ lo + m < n → twist n = Bool.true) →\n        (∀ (v : ResearchCommons.TwoLiftTriangle.Vertex), lo ≤ v.fst → keep v) →\n          ∀ (b : Bool),\n            have vs := ResearchCommons.TriangleRun.runVertices lo (lo + m) b;\n            vs.Nodup ∧\n              vs.length = m + 1 + 2 ∧\n                ∀ (v : ResearchCommons.TwoLiftTriangle.Vertex),\n                  ResearchCommons.TriangleRun.Reach (ResearchCommons.TriangleRun.GraphTriangleEdge twist keep) (lo, b)\n                      v ↔\n                    v ∈ vs",
      "closure": "closed",
      "provenance": {
        "kind": "internal",
        "reference": "https://github.com/Sodelin/Research-Commons/blob/135abac97d5a73e32af97911e7b18ed87f450178/research/2026-11-25-proofbridge-linear/capped-host/zero-run/TriangleRun.lean"
      }
    },
