'ResearchCommons.ThueMorsePhaseAliasing.prefix_aliases_with_cofinal_separation' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
ResearchCommons.ThueMorsePhaseAliasing.prefix_aliases_with_cofinal_separation : ∀ (a len gap : Nat),
  ∃ b,
    a + gap < b ∧
      (∀ (i : Nat), i < len → ThueMorseBits.t (i + a) = ThueMorseBits.t (i + b)) ∧
        ∀ (N : Nat),
          (∃ i, N ≤ i ∧ ThueMorseBits.t (i + a) = ThueMorseBits.t (i + b)) ∧
            ∃ i, N ≤ i ∧ ThueMorseBits.t (i + a) ≠ ThueMorseBits.t (i + b)
'ResearchCommons.ThueMorsePhaseAliasing.prefix_aliases_with_cofinal_separation' depends on axioms: [propext,
 Classical.choice,
 Quot.sound]
ResearchCommons.ThueMorsePhaseAliasing.triple_dyadic_first_mismatch : ∀ (m : Nat),
  (∀ (n : Nat), n < 2 * 2 ^ m → ThueMorseBits.t n = ThueMorseBits.t (n + 3 * 2 ^ m)) ∧
    ThueMorseBits.t (2 * 2 ^ m) ≠ ThueMorseBits.t (2 * 2 ^ m + 3 * 2 ^ m)
'ResearchCommons.ThueMorsePhaseAliasing.triple_dyadic_first_mismatch' depends on axioms: [propext, Quot.sound]
ThueMorseReuse.zeroCount_exact : ∀ (n : Nat),
  6 * ThueMorseReuse.zeroCount n =
    2 * ↑(n + 1) + ThueMorseReuse.alternatingDigitValue (n + 1) - 3 * ThueMorseReuse.asInt (ThueMorseBits.t (n + 1))
'ThueMorseReuse.zeroCount_exact' depends on axioms: [propext, Quot.sound]
