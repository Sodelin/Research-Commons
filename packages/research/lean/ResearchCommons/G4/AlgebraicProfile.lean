import Mathlib.RingTheory.Polynomial.Basic
import Mathlib.RingTheory.Ideal.Maps

/-!
# Finite original response equations on one fixed parameter ring

Formal use of the retained all-profile descent proof's Hilbert-basis step.
The finite set consists of original response indices, not arbitrary ideal
generators. One tuple is evaluated in every response. This provides no
effective index bound, real-closed-field witness transfer, original source
admission, enumeration/forcing algorithm or G4 stopping theorem.
-/

noncomputable section
namespace ResearchCommons.G4.AlgebraicProfile

/-- A finitely generated ideal generated by a response family has a finite
generating subfamily of the ORIGINAL indices. The family may be infinite. -/
theorem finite_original_generators
    {R : Type*} [CommRing R] [IsNoetherianRing R]
    {ι : Type*} (f : ι → R) :
    ∃ J : Finset ι,
      Ideal.span (Set.range f) = Ideal.span (f '' (↑J : Set ι)) := by
  classical
  have hfg : (Submodule.span R (Set.range f)).FG :=
    IsNoetherian.noetherian _
  obtain ⟨s, hs, heq⟩ :=
    (Submodule.fg_span_iff_fg_span_finset_subset (R := R) (Set.range f)).mp hfg
  change Ideal.span (Set.range f) = Ideal.span (↑s : Set R) at heq
  let pick : (↑s : Set R) → ι := fun x => Classical.choose (hs x.property)
  have hpick (x : (↑s : Set R)) : f (pick x) = x.val :=
    Classical.choose_spec (hs x.property)
  let J : Finset ι := Finset.univ.image pick
  refine ⟨J, le_antisymm ?_ ?_⟩
  · rw [heq]
    apply Ideal.span_le.mpr
    intro y hy
    have hys : y ∈ s := hy
    apply Ideal.subset_span
    refine ⟨pick ⟨y, hys⟩, ?_, hpick ⟨y, hys⟩⟩
    change pick ⟨y, hys⟩ ∈ J
    exact Finset.mem_image.mpr ⟨⟨y, hys⟩, Finset.mem_univ _, rfl⟩
  · apply Ideal.span_mono
    rintro y ⟨i, _, rfl⟩
    exact ⟨i, rfl⟩

/-- The same finite original equations determine vanishing under EVERY
homomorphism to one coefficient extension. No chosen solution is a premise. -/
theorem finite_vanishing_equations
    {R S : Type*} [CommRing R] [IsNoetherianRing R] [CommRing S]
    {ι : Type*} (f : ι → R) :
    ∃ J : Finset ι, ∀ φ : R →+* S,
      (∀ i, φ (f i) = 0) ↔ (∀ i ∈ J, φ (f i) = 0) := by
  obtain ⟨J, hJ⟩ := finite_original_generators f
  refine ⟨J, fun φ => ⟨fun h i _ => h i, ?_⟩⟩
  intro h i
  have hspan : Ideal.span (Set.range f) ≤ RingHom.ker φ := by
    rw [hJ]
    apply Ideal.span_le.mpr
    rintro y ⟨j, hj, rfl⟩
    exact RingHom.mem_ker.mpr (h j hj)
  exact RingHom.mem_ker.mp (hspan (Ideal.subset_span ⟨i, rfl⟩))

/-- On ONE finite-variable parameter ring, all prescribed responses are
equivalent to finitely many ORIGINAL response equations, evaluated at the
SAME tuple in the SAME coefficient extension. This is existence, not a
computable determining prefix against unknown source shapes. -/
theorem finite_response_equations
    {K L σ ι : Type*} [CommRing K] [IsNoetherianRing K]
    [CommRing L] [Finite σ]
    (P : ι → MvPolynomial σ K) (a : ι → K) (coeff : K →+* L) :
    ∃ J : Finset ι, ∀ η : σ → L,
      (∀ i, MvPolynomial.eval₂Hom coeff η (P i) = coeff (a i)) ↔
      (∀ i ∈ J, MvPolynomial.eval₂Hom coeff η (P i) = coeff (a i)) := by
  obtain ⟨J, hJ⟩ := finite_vanishing_equations (S := L)
    (fun i => P i - MvPolynomial.C (a i))
  refine ⟨J, fun η => ?_⟩
  simpa only [map_sub, MvPolynomial.eval₂Hom_C, sub_eq_zero]
    using hJ (MvPolynomial.eval₂Hom coeff η)

end ResearchCommons.G4.AlgebraicProfile
